Identifiers":{"latestAnswer(PriceOracle_v1.Feed,PriceOracle_v1.Constraints)":"d74eb78a"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"feed\",\"type\":\"address\"},{\"internalType\":\"int256\",\"name\":\"price\",\"type\":\"int256\"}],\"name\":\"InvalidUnderlyingPrice\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"feed\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"timestamp\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"currentTime\",\"type\":\"uint256\"}],\"name\":\"StaleUnderlyingPrice\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"feed\",\"type\":\"address\"},{\"internalType\":\"int256\",\"name\":\"newPrice\",\"type\":\"int256\"},{\"internalType\":\"int256\",\"name\":\"prevPrice\",\"type\":\"int256\"},{\"internalType\":\"uint256\",\"name\":\"maxDeviationPercent\",\"type\":\"uint256\"}],\"name\":\"UnderlyingPriceDeviation\",\"type\":\"error\"},{\"inputs\":[{\"components\":[{\"internalType\":\"contract AggregatorV3Interface\",\"name\":\"priceFeed\",\"type\":\"AggregatorV3Interface\"},{\"internalType\":\"uint8\",\"name\":\"decimals\",\"type\":\"uint8\"}],\"internalType\":\"struct PriceOracle_v1.Feed\",\"name\":\"feed\",\"type\":\"tuple\"},{\"components\":[{\"internalType\":\"uint64\",\"name\":\"maxAnswerAge\",\"type\":\"uint64\"},{\"internalType\":\"uint256\",\"name\":\"maxPercentageDeviation\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"maxAbsoluteDeviation\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"maxTrendReversalDeviation\",\"type\":\"uint256\"}],\"internalType\":\"struct PriceOracle_v1.Constraints\",\"name\":\"constraints\",\"type\":\"tuple\"}],\"name\":\"latestAnswer\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"price\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"All price values returned and validated by this library are normalized to 18 decimals.      All constraints (max deviations, etc.) are interpreted in 18 decimals.      This ensures consistent, safe, and least-surprise behavior for all consumers.      The library performs normalization, validation, and delivers normalized values.      If a constraint is violated, a revert is triggered with normalized values in the error.\",\"errors\":{\"InvalidUnderlyingPrice(address,int256)\":[{\"details\":\"A valid price must be greater than zero\",\"params\":{\"feed\":\"The address of the price feed\",\"price\":\"The invalid (zero or negative) price returned by the feed\"}}],\"StaleUnderlyingPrice(address,uint256,uint256)\":[{\"details\":\"Ensures only fresh price data is used\",\"params\":{\"currentTime\":\"The current block timestamp\",\"feed\":\"The address of the price feed\",\"timestamp\":\"When the price was last updated on the oracle\"}}],\"UnderlyingPriceDeviation(address,int256,int256,uint256)\":[{\"details\":\"Protects against flash crashes, manipulation, or data errors\",\"params\":{\"feed\":\"The address of the price feed\",\"maxDeviationPercent\":\"The maximum allowed percentage deviation\",\"newPrice\":\"The current round's price\",\"prevPrice\":\"The previous round's price\"}}]},\"kind\":\"dev\",\"methods\":{\"latestAnswer(PriceOracle_v1.Feed,PriceOracle_v1.Constraints)\":{\"details\":\"All returned and validated values are normalized to 18 decimals.\",\"params\":{\"constraints\":\"Constraints struct for validation (all in 18 decimals)\",\"feed\":\"Feed struct containing priceFeed, decimals\"},\"returns\":{\"price\":\"The validated price (positive value, 18 decimals)\"}}},\"title\":\"PriceOracle_v1\",\"version\":1},\"userdoc\":{\"errors\":{\"InvalidUnderlyingPrice(address,int256)\":[{\"notice\":\"Thrown when the price feed returns a non-positive value\"}],\"StaleUnderlyingPrice(address,uint256,uint256)\":[{\"notice\":\"Thrown when the price data is older than the allowed staleness threshold\"}],\"UnderlyingPriceDeviation(address,int256,int256,uint256)\":[{\"notice\":\"Thrown when there's an abnormal price change between rounds\"}]},\"kind\":\"user\",\"methods\":{\"latestAnswer(PriceOracle_v1.Feed,PriceOracle_v1.Constraints)\":{\"notice\":\"Validates and normalizes price data from a Chainlink feed.\"}},\"notice\":\"Library for validating Chainlink price feed data.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/price/PriceOracle_v1.sol\":\"PriceOracle_v1\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":700},\"remappings\":[\":@bao/=lib/bao-base/src/\",\":@chainlink/contracts/=lib/chainlink-brownie-contracts/contracts/src/v0.8/\",\":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/\",\":@solady/=lib/solady/src/\",\":ds-test/=lib/forge-std/lib/ds-test/src/\",\":dummy/=/lib/dummy/\",\":forge-std/=lib/forge-std/src/\",\":openzeppelin-foundry-upgrades/=lib/openzeppelin-foundry-upgrades/src/\",\":solidity-stringutils/=lib/openzeppelin-foundry-upgrades/lib/solidity-stringutils/\"]},\"sources\":{\"lib/chainlink-brownie-contracts/contracts/src/v0.8/shared/interfaces/AggregatorV3Interface.sol\":{\"keccak256\":\"0x257a8d28fa83d3d942547c8e129ef465e4b5f3f31171e7be4739a4c98da6b4f0\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6d39e11b1dc7b9b8ccdabbc9be442ab7cda4a81c748f57e316dcb1bcb4a28bf9\",\"dweb:/ipfs/QmaG6vz6W6iEUBsbHSBob5mdcitYxWjoygxREHpsJHfWrS\"]},\"lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/utils/math/SafeCast.sol\":{\"keccak256\":\"0x195533c86d0ef72bcc06456a4f66a9b941f38eb403739b00f21fd7c1abd1ae54\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://b1d578337048cad08c1c03041cca5978eff5428aa130c781b271ad9e5566e1f8\",\"dweb:/ipfs/QmPFKL2r9CBsMwmUqqdcFPfHZB