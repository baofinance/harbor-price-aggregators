# FXUSD_ETH v3 Move History
set datafile separator ","
set terminal svg enhanced size 600 600 background rgb "gray90"
# set output "FXUSD_ETH_v3_daily_3y.svg"

set title "FXUSD/ETH v3 Move History"

# X-axis: Unix timestamp to human-readable date
set xdata time
set timefmt "%s"
set format x "%d%b%y"
set xlabel "Date"
set xtics rotate by 90 right

# Y-axis: move is normalized WAD (1e18 == 1.0 == 100%)
set ylabel "Move (1 = 100%)"
set ytics
set format y "%.4f"
set yrange [*:*] extend

set grid
set key autotitle columnheader noenhanced below title " "

# Columns (generated by FxUsdEthV3Daily3YearDump):
# 1 block
# 2 timestamp
# 3 time
# 4 minPrice
# 5 maxPrice
# 6 minRate
# 7 maxRate
# 8 move (signed, WAD/day)
# 9 move24hAbs (unsigned, WAD)
# 10 error

plot "FXUSD_ETH_v3_daily_3y.csv" skip 1 using 2:($8/1e18) with lines lc rgb "blue" title "move (per day)", \
     "" skip 1 using 2:($9/1e18) with lines lc rgb "red" title "move24hAbs (max intraday)"
