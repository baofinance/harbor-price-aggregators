#!/usr/bin/env bash
set -euo pipefail

# Harbor Generic Oracle Deployment Script v3 (first batch)
#
# Orchestrates a multi-oracle run by calling:
#   script/harbor-oracle-v3
#
# IMPORTANT:
# - This script must be run from the project root (fails otherwise).

usage() {
  cat <<EOF
Usage:
  $0 --network <network> [--local] [--salt <prefix>] [--account <name>] \\
     <--deploy|--deploy-impl|--check|--verify|--verify-impl>

Notes:
  - Forwards args to script/harbor-oracle-v3 with --base/--quote for each oracle.
  - Do not pass --base/--quote yourself.
  - You MUST specify one of the mode flags (--deploy, --deploy-impl, etc.)
EOF
}

require_project_root() {
  if [[ ! -f "foundry.toml" ]] || [[ ! -d "src" ]] || [[ ! -d "script" ]]; then
    echo "❌ Must be run from the project root (missing foundry.toml/src/script)" >&2
    exit 1
  fi
}

# Check that user provided an execution mode
has_mode_flag() {
  for arg in "$@"; do
    case "$arg" in
      --deploy | --deploy-impl | --check | --verify | --verify-impl)
        return 0
        ;;
    esac
  done
  return 1
}

# Oracle set (explicit list)
# Format: BASE|QUOTE
ORACLES=(
  "fxUSD|ETH"
  "fxUSD|BTC"
  "fxUSD|EUR"
  "fxUSD|XAU"
  "fxUSD|MCAP"
  "stETH|BTC"
  "stETH|EUR"
  "stETH|XAU"
  "stETH|MCAP"
)

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

require_project_root

if ! has_mode_flag "$@"; then
  echo "❌ Missing mode flag. Specify one of: --deploy, --deploy-impl, --check, --verify, --verify-impl" >&2
  usage >&2
  exit 1
fi

SINGLE_SCRIPT="script/harbor-oracle-v3"
if [[ ! -f "$SINGLE_SCRIPT" ]]; then
  echo "❌ Missing single-oracle script: $SINGLE_SCRIPT" >&2
  exit 1
fi

# Box drawing helpers
box_line() {
  printf '═%.0s' {1..60}
  echo
}
section_line() {
  printf '─%.0s' {1..50}
  echo
}

echo ""
box_line
echo "║  V3 ORACLE FIRST BATCH"
echo "║  Script: $0"
echo "║  Single: $SINGLE_SCRIPT"
echo "║  Args:   $*"
box_line
echo ""

oracle_count=${#ORACLES[@]}

# Phase A: Validate shared config (no --base/--quote)
echo "── Phase A: Validate shared config ──────────────"
if ! bash "$SINGLE_SCRIPT" "$@" --validate-args 2>&1; then
  echo "" >&2
  echo "❌ Shared config validation failed. Aborting." >&2
  exit 1
fi
echo ""

# Phase B: Validate each oracle (with --base/--quote)
echo "── Phase B: Validate all $oracle_count oracles ──────────────"
validation_failed=false
for entry in "${ORACLES[@]}"; do
  IFS='|' read -r base quote <<<"$entry"
  if [[ -z "$base" ]] || [[ -z "$quote" ]]; then
    echo "  ❌ Invalid ORACLES entry: $entry" >&2
    validation_failed=true
    continue
  fi

  if ! bash "$SINGLE_SCRIPT" "$@" --base "$base" --quote "$quote" --validate-args 2>&1; then
    validation_failed=true
  fi
done

if [[ "$validation_failed" == "true" ]]; then
  echo "" >&2
  echo "❌ Oracle validation failed. Aborting before any deployments." >&2
  exit 1
fi
echo ""

# Phase C: Execute each oracle
echo "── Phase C: Execute $oracle_count oracles ──────────────────"
fail=false
oracle_num=0

for entry in "${ORACLES[@]}"; do
  IFS='|' read -r base quote <<<"$entry"
  ((oracle_num++)) || true

  if [[ -z "$base" ]] || [[ -z "$quote" ]]; then
    echo "❌ Invalid ORACLES entry: $entry" >&2
    fail=true
    continue
  fi

  echo ""
  box_line
  echo "║  [$oracle_num/$oracle_count]  $base / $quote"
  box_line
  echo ""

  if ! bash "$SINGLE_SCRIPT" "$@" --base "$base" --quote "$quote"; then
    fail=true
  fi
done

if [[ "$fail" == "true" ]]; then
  echo ""
  box_line
  echo "║  ❌ One or more oracle operations failed"
  box_line
  exit 1
fi

echo ""
box_line
echo "║  ✅ All $oracle_count oracles completed successfully"
box_line
