#!/usr/bin/env bash
set -euo pipefail

# Harbor Generic Oracle Deployment Script v3 - Mainnet (V3 Contracts)
#
# This script deploys:
# - Per-oracle V3 implementation contracts (immutables wired in the implementation)
# - Deterministic ERC1967Proxy endpoints via BaoFactory (CREATE3)
#
# Deterministic proxy identity (harbor_v1 requirement):
#   harbor_v1::Oracle_v3::<base-name>::<quote-name>
#
# BaoFactory address (all supported chains):
#   0xD696E56b3A054734d4C6DCBD32E11a278b0EC458

usage() {
  cat <<EOF
Usage:
  $0 --rpc-url <local|mainnet> --salt <salt-prefix> [--account <account>] [--etherscan-api-key <key>] [--deploy|--check|--verify-impl|--verify]

Notes:
  - --rpc-url only accepts: local | mainnet
    These names are resolved via foundry.toml `[rpc_endpoints]`.
  - --salt is a UTF-8 string prefix. The script appends "::<base-name>::<quote-name>".
  - BaoFactory is assumed to already be deployed at the canonical address.

Signer:
  - For mainnet: --account is required (uses ~/.foundry/keystores/<account>). 
  - For local: if --account is omitted, the script uses the first anvil private key.

Verify:
  - --verify-impl / --verify require --etherscan-api-key.
  - --rpc-url mainnet uses Foundry's RPC endpoint named "mainnet".
EOF
}

FORGE=forge
CAST=cast

STATE_FILE=deployment-state-v3.json

BAO_FACTORY=0xD696E56b3A054734d4C6DCBD32E11a278b0EC458

# Harbor multisig owner for v3 proxies
OWNER=0x9bABfC1A1952a6ed2caC1922BFfE80c0506364a2

# Oracle set (extend this list to add more oracles)
# Format: BASE|QUOTE
# The script derives:
# - key: <BASE>_<QUOTE> (uppercased)
# - contract: Oracle_<BASE>_<QUOTE>_Mainnet (by convention)
# - contract id: src/price/oracles/<contract>.sol:<contract>
ORACLES=(
  "fxUSD|ETH"
  "stETH|BTC"
)

RPC_NETWORK=""
SALT_PREFIX=""
ACCOUNT_NAME=""
MODE="deploy"
ETHERSCAN_API_KEY=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rpc-url)
      RPC_NETWORK=${2:-}
      shift 2
      ;;
    --salt)
      SALT_PREFIX=${2:-}
      shift 2
      ;;
    --account)
      ACCOUNT_NAME=${2:-}
      shift 2
      ;;
    --etherscan-api-key)
      ETHERSCAN_API_KEY=${2:-}
      shift 2
      ;;
    --deploy)
      MODE="deploy"
      shift
      ;;
    --check)
      MODE="check"
      shift
      ;;
    --verify-impl|--veryify-impl)
      MODE="verify-impl"
      shift
      ;;
    --verify)
      MODE="verify"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "❌ Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

declare -A ORACLE_BASE=()
declare -A ORACLE_QUOTE=()
declare -A ORACLE_CONTRACT=()
declare -A ORACLE_IMPL=()
declare -A ORACLE_PROXY=()
ORACLE_KEYS=()

for entry in "${ORACLES[@]}"; do
  IFS='|' read -r base quote <<<"$entry"
  if [[ -z "$base" ]] || [[ -z "$quote" ]]; then
    echo "❌ Invalid ORACLES entry: $entry" >&2
    exit 1
  fi

  key="${base^^}_${quote^^}"
  contract_name="Oracle_${base}_${quote}_Mainnet"
  src_file="src/price/oracles/${contract_name}.sol"
  contract_id="${src_file}:${contract_name}"

  if [[ ! -f "$src_file" ]]; then
    echo "❌ Missing oracle source file: $src_file (from ORACLES entry '$entry')" >&2
    exit 1
  fi

  if ! grep -Eq "^[[:space:]]*(abstract[[:space:]]+)?contract[[:space:]]+${contract_name}\b" "$src_file"; then
    echo "❌ Expected contract '${contract_name}' not found in $src_file" >&2
    exit 1
  fi

  ORACLE_KEYS+=("$key")
  ORACLE_BASE["$key"]="$base"
  ORACLE_QUOTE["$key"]="$quote"
  ORACLE_CONTRACT["$key"]="$contract_id"
done

if [[ -z "$RPC_NETWORK" ]]; then
  echo "❌ Missing --rpc-url" >&2
  usage >&2
  exit 1
fi

if [[ -z "$SALT_PREFIX" ]]; then
  echo "❌ Missing --salt" >&2
  usage >&2
  exit 1
fi

if [[ "$RPC_NETWORK" != "local" ]] && [[ "$RPC_NETWORK" != "mainnet" ]]; then
  echo "❌ --rpc-url must be one of: local | mainnet" >&2
  exit 1
fi

if [[ "$RPC_NETWORK" == "mainnet" ]] && [[ -z "$ACCOUNT_NAME" ]]; then
  echo "❌ --account is required when --rpc-url mainnet" >&2
  exit 1
fi

SIGNER_ARGS=()
if [[ -n "$ACCOUNT_NAME" ]]; then
  SIGNER_ARGS=(--account "$ACCOUNT_NAME")
elif [[ "$RPC_NETWORK" == "local" ]]; then
  # First anvil private key
  SIGNER_ARGS=(--private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
fi

CHAIN_ID=$("$CAST" chain-id --rpc-url "$RPC_NETWORK" 2>/dev/null || echo "unknown")
echo "=== Network Check ==="
echo "Network:  $RPC_NETWORK"
echo "RPC URL:  $RPC_NETWORK"
echo "Chain ID: $CHAIN_ID"
echo ""

DEPLOYER=""
if [[ -n "$ACCOUNT_NAME" ]]; then
  DEPLOYER=$("$CAST" wallet address --account "$ACCOUNT_NAME")
else
  DEPLOYER=$("$CAST" wallet address --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
fi

echo "=== BaoFactory Check ==="
echo "BaoFactory: $BAO_FACTORY"
echo "Deployer:   $DEPLOYER"
echo "Owner:      $OWNER"
IS_OP=$("$CAST" call "$BAO_FACTORY" "isCurrentOperator(address)(bool)" "$DEPLOYER" --rpc-url "$RPC_NETWORK" 2>/dev/null || echo "")
if [[ -n "$IS_OP" ]]; then
  echo "Operator:   $IS_OP"
fi
echo ""

# -----------------------------------------------------------------------------
# State helpers
# -----------------------------------------------------------------------------

load_state() {
  if [[ ! -f "$STATE_FILE" ]]; then
    return 1
  fi

  for key in "${ORACLE_KEYS[@]}"; do
    ORACLE_IMPL["$key"]=$(jq -r ".implementations.$key // empty" "$STATE_FILE" 2>/dev/null || echo "")
    ORACLE_PROXY["$key"]=$(jq -r ".proxies.$key // empty" "$STATE_FILE" 2>/dev/null || echo "")
  done

  return 0
}

# -----------------------------------------------------------------------------
# Deterministic deployment helpers
# -----------------------------------------------------------------------------

salt_string() {
  local base=$1
  local quote=$2

  if [[ "$SALT_PREFIX" == *"::" ]]; then
    echo "${SALT_PREFIX}${base}::${quote}"
  else
    echo "${SALT_PREFIX}::${base}::${quote}"
  fi
}

salt_bytes32() {
  local salt_str=$1
  "$CAST" keccak "$("$CAST" from-utf8 "$salt_str")"
}

predict_address() {
  local salt_b32=$1
  "$CAST" call "$BAO_FACTORY" "predictAddress(bytes32)(address)" "$salt_b32" --rpc-url "$RPC_NETWORK"
}

has_code() {
  local addr=$1
  local code
  code=$("$CAST" code "$addr" --rpc-url "$RPC_NETWORK" 2>/dev/null | head -n 1 || echo "0x")
  [[ "$code" != "0x" ]]
}

# -----------------------------------------------------------------------------
# Modes
# -----------------------------------------------------------------------------

if [[ "$MODE" == "check" ]]; then
  echo "=== CHECKING V3 ORACLE ENDPOINTS ==="
  echo ""
  ok=true

  for key in "${ORACLE_KEYS[@]}"; do
    base=${ORACLE_BASE[$key]}
    quote=${ORACLE_QUOTE[$key]}

    salt_str=$(salt_string "$base" "$quote")
    salt_b32=$(salt_bytes32 "$salt_str")
    predicted=$(predict_address "$salt_b32")

    echo "--- $key ---"
    echo "Salt:      $salt_str"
    echo "Salt hash: $salt_b32"
    echo "Predicted: $predicted"

    if ! has_code "$predicted"; then
      echo "❌ Not deployed (no code)"
      ok=false
      continue
    fi

    name=$("$CAST" call "$predicted" "oracleName()(string)" --rpc-url "$RPC_NETWORK" 2>/dev/null || echo "")
    if [[ -z "$name" ]]; then
      echo "⚠️  Deployed but oracleName() failed"
      ok=false
      continue
    fi

    echo "✅ Deployed (oracleName: $name)"
  done

  echo ""
  if [[ "$ok" == "true" ]]; then
    echo "✅ All checked endpoints are deployed"
  else
    echo "⚠️  Some endpoints are missing or unhealthy"
  fi
  exit 0
fi

if [[ "$MODE" == "verify-impl" ]]; then
  if [[ -z "$ETHERSCAN_API_KEY" ]]; then
    echo "❌ Missing --etherscan-api-key. Cannot verify contracts."
    exit 1
  fi

  load_state || true

  echo "=== VERIFYING IMPLEMENTATION CONTRACTS ON ETHERSCAN (V3) ==="
  echo ""

  for key in "${ORACLE_KEYS[@]}"; do
    impl=${ORACLE_IMPL[$key]:-}
    contract_id=${ORACLE_CONTRACT[$key]}

    if [[ -n "$impl" ]] && [[ "$impl" != "null" ]]; then
      echo "Verifying $contract_id implementation: $impl"
      "$FORGE" verify-contract \
        "$impl" \
        "$contract_id" \
        --verifier etherscan \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --compiler-version 0.8.30 \
        --chain mainnet
      echo ""
    else
      echo "⚠️  $key implementation not set (deploy first or set it in $STATE_FILE)"
    fi
  done

  echo ""
  echo "✅ Implementation verification complete"
  exit 0
fi

if [[ "$MODE" == "verify" ]]; then
  if [[ -z "$ETHERSCAN_API_KEY" ]]; then
    echo "❌ Missing --etherscan-api-key. Cannot verify contracts."
    exit 1
  fi

  load_state || true

  missing_impl=false
  for key in "${ORACLE_KEYS[@]}"; do
    if [[ -z "${ORACLE_IMPL[$key]:-}" ]]; then
      missing_impl=true
    fi
  done
  if [[ "$missing_impl" == "true" ]]; then
    echo "❌ Missing implementations in state; run deploy first (or populate implementations in $STATE_FILE)"
    exit 1
  fi

  # Proxy addresses are deterministic; compute them from salts.
  for key in "${ORACLE_KEYS[@]}"; do
    base=${ORACLE_BASE[$key]}
    quote=${ORACLE_QUOTE[$key]}
    salt_str=$(salt_string "$base" "$quote")
    salt_b32=$(salt_bytes32 "$salt_str")
    ORACLE_PROXY["$key"]=$(predict_address "$salt_b32")
  done

  echo "=== VERIFYING ALL CONTRACTS ON ETHERSCAN (V3) ==="
  echo ""

  # Verify implementations
  verify_impl_args=("$0" --rpc-url "$RPC_NETWORK" --salt "$SALT_PREFIX" --etherscan-api-key "$ETHERSCAN_API_KEY" --verify-impl)
  if [[ -n "$ACCOUNT_NAME" ]]; then
    verify_impl_args+=(--account "$ACCOUNT_NAME")
  fi
  "${verify_impl_args[@]}"

  echo ""
  echo "=== Verifying Proxy Contracts ==="

  local_init_data=$("$CAST" calldata "initialize(address)" "$OWNER")

  for key in "${ORACLE_KEYS[@]}"; do
    impl=${ORACLE_IMPL[$key]}
    proxy=${ORACLE_PROXY[$key]}
    proxy_args=$("$CAST" abi-encode "constructor(address,bytes)" "$impl" "$local_init_data")

    echo "Verifying $key proxy: $proxy"
    "$FORGE" verify-contract \
      "$proxy" \
      lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --constructor-args "$proxy_args" \
      --compiler-version 0.8.30 \
      --chain mainnet
    echo ""
  done

  echo ""
  echo "✅ Verification complete"
  exit 0
fi

# Default: deploy

load_state && echo "📂 Loaded state from $STATE_FILE" || true

echo "=== DEPLOYING V3 IMPLEMENTATIONS ==="

for key in "${ORACLE_KEYS[@]}"; do
  contract_id=${ORACLE_CONTRACT[$key]}
  current_impl=${ORACLE_IMPL[$key]:-}

  if [[ -n "$current_impl" ]] && [[ "$current_impl" != "null" ]]; then
    echo "✓ Implementation already set ($contract_id): $current_impl"
    continue
  fi

  echo "Deploying implementation: $contract_id"
  out=$("$FORGE" create "$contract_id" --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --broadcast)

  deployed=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$out" | awk '{print $3}')
  if [[ -z "$deployed" ]]; then
    echo "❌ Failed to parse implementation address for $contract_id"
    exit 1
  fi

  ORACLE_IMPL["$key"]="$deployed"
  echo "  ✓ Deployed: $deployed"
done

echo ""
echo "=== DEPLOYING / DISCOVERING DETERMINISTIC PROXIES (BaoFactory) ==="

for key in "${ORACLE_KEYS[@]}"; do
  base=${ORACLE_BASE[$key]}
  quote=${ORACLE_QUOTE[$key]}
  impl=${ORACLE_IMPL[$key]}

  salt_str=$(salt_string "$base" "$quote")
  salt_b32=$(salt_bytes32 "$salt_str")
  predicted=$(predict_address "$salt_b32")

  echo "--- $key ---"
  echo "Salt:      $salt_str"
  echo "Salt hash: $salt_b32"
  echo "Predicted: $predicted"

  if has_code "$predicted"; then
    echo "✓ Proxy already exists: $predicted"
    ORACLE_PROXY["$key"]="$predicted"
    echo ""
    continue
  fi

  init_data=$("$CAST" calldata "initialize(address)" "$OWNER")

  # Pull ERC1967Proxy creation bytecode from compiled artifacts.
  # This works because ERC1967Proxy is already a dependency used in tests.
  proxy_bytecode=$("$FORGE" inspect ERC1967Proxy bytecode)
  proxy_args=$("$CAST" abi-encode "constructor(address,bytes)" "$impl" "$init_data")
  init_code="${proxy_bytecode}${proxy_args:2}"

  echo "Deploying proxy via BaoFactory..."

  # BaoFactory has overloaded deploy(); disambiguate by explicit signature.
  tx=$("$CAST" send "$BAO_FACTORY" "deploy(bytes,bytes32)(address)" "$init_code" "$salt_b32" \
    --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --json)

  tx_hash=$(jq -r '.transactionHash // empty' <<<"$tx" 2>/dev/null || echo "")
  if [[ -n "$tx_hash" ]]; then
    echo "  ✓ Tx: $tx_hash"
  fi

  # CREATE3 address is deterministic; if tx succeeded, code should now exist at predicted.
  echo "  ⏳ Waiting for code..."
  sleep 5

  if ! has_code "$predicted"; then
    echo "❌ Deployment transaction sent but no code found at predicted address: $predicted" >&2
    exit 1
  fi

  echo "  ✓ Deployed proxy: $predicted"
  ORACLE_PROXY["$key"]="$predicted"
  echo ""
done

echo ""
echo "=== DEPLOYMENT SUMMARY (V3) ==="
echo "Implementations:"
for key in "${ORACLE_KEYS[@]}"; do
  echo "  $key: ${ORACLE_IMPL[$key]}"
done
echo "Proxies (deterministic):"
for key in "${ORACLE_KEYS[@]}"; do
  echo "  $key: ${ORACLE_PROXY[$key]}"
done
echo ""

{
  impl_entries=""
  proxy_entries=""
  salt_entries=""
  first=true

  for key in "${ORACLE_KEYS[@]}"; do
    base=${ORACLE_BASE[$key]}
    quote=${ORACLE_QUOTE[$key]}
    salt_str=$(salt_string "$base" "$quote")

    if [[ "$first" == "true" ]]; then
      first=false
    else
      impl_entries+=$',\n'
      proxy_entries+=$',\n'
      salt_entries+=$',\n'
    fi

    impl_entries+="    \"$key\": \"${ORACLE_IMPL[$key]}\""
    proxy_entries+="    \"$key\": \"${ORACLE_PROXY[$key]}\""
    salt_entries+="    \"$key\": \"$salt_str\""
  done

  cat >"$STATE_FILE" <<EOF
{
  "baoFactory": "${BAO_FACTORY}",
  "owner": "${OWNER}",
  "implementations": {
${impl_entries}
  },
  "proxies": {
${proxy_entries}
  },
  "salts": {
${salt_entries}
  },
  "deployment_time": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "version": "v3"
}
EOF
}
echo "✓ State saved to $STATE_FILE"

# Quick health checks

echo ""
echo "=== ORACLE NAMES ==="
for key in "${ORACLE_KEYS[@]}"; do
  echo -n "$key: "
  "$CAST" call "${ORACLE_PROXY[$key]}" "oracleName()(string)" --rpc-url "$RPC_NETWORK" 2>/dev/null || true
done

echo ""
echo "✅ Done"
