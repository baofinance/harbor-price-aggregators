#!/usr/bin/env bash
set -euo pipefail

# Harbor Generic Oracle Deployment Script v3 (first batch)
#
# Orchestrates a multi-aggregator run by calling:
#   script/deploy-one-aggregator
#
# IMPORTANT:
# - This script must be run from the project root (fails otherwise).

# Oracle set (explicit list)
# Format: BASE|QUOTE
ORACLES=(
  "fxUSD|ETH"
  "fxUSD|BTC"
  "fxUSD|EUR"
  "fxUSD|XAU"
  "fxUSD|MCAP"
  "stETH|BTC"
  "stETH|EUR"
  "stETH|XAU"
  "stETH|MCAP"
)

SINGLE_SCRIPT="script/deploy-one-aggregator"
if [[ ! -f "$SINGLE_SCRIPT" ]]; then
  echo "❌ Missing single-aggregator script: $SINGLE_SCRIPT" >&2
  exit 1
fi

# Box drawing helpers
box_line() {
  printf '═%.0s' {1..60}
  echo
}
section_line() {
  printf '─%.0s' {1..50}
  echo
}

echo ""
box_line
echo "║  V3 ORACLE FIRST BATCH"
echo "║  Script: $0"
echo "║  Single: $SINGLE_SCRIPT"
echo "║  Args:   $*"
box_line
echo ""

oracle_count=${#ORACLES[@]}

# Phase A: Validate shared config (no --base/--quote)
echo "── Phase A: Validate shared config ──────────────"
if ! bash "$SINGLE_SCRIPT" "$@" --validate-args 2>&1; then
  echo "" >&2
  echo "❌ Shared config validation failed. Aborting." >&2
  exit 1
fi
echo ""

# Phase B: Validate each aggregator (with --base/--quote)
echo "── Phase B: Validate all $oracle_count aggregators ──────────────"
validation_failed=false
for entry in "${ORACLES[@]}"; do
  IFS='|' read -r base quote <<<"$entry"
  if [[ -z "$base" ]] || [[ -z "$quote" ]]; then
    echo "  ❌ Invalid ORACLES entry: $entry" >&2
    validation_failed=true
    continue
  fi

  if ! bash "$SINGLE_SCRIPT" "$@" --base "$base" --quote "$quote" --validate-args 2>&1; then
    validation_failed=true
  fi
done

if [[ "$validation_failed" == "true" ]]; then
  echo "" >&2
  echo "❌ Oracle validation failed. Aborting before any deployments." >&2
  exit 1
fi
echo ""

# Phase C: Execute each aggregator
echo "── Phase C: Execute $oracle_count aggregators ──────────────────"
fail=false
oracle_num=0

for entry in "${ORACLES[@]}"; do
  IFS='|' read -r base quote <<<"$entry"
  ((oracle_num++)) || true

  if [[ -z "$base" ]] || [[ -z "$quote" ]]; then
    echo "❌ Invalid ORACLES entry: $entry" >&2
    fail=true
    continue
  fi

  echo ""
  box_line
  echo "║  [$oracle_num/$oracle_count]  $base / $quote"
  box_line
  echo ""

  if ! bash "$SINGLE_SCRIPT" "$@" --base "$base" --quote "$quote"; then
    fail=true
  fi
done

if [[ "$fail" == "true" ]]; then
  echo ""
  box_line
  echo "║  ❌ One or more aggregator operations failed"
  box_line
  exit 1
fi

echo ""
box_line
echo "║  ✅ All $oracle_count aggregators completed successfully"
box_line
