#!/usr/bin/env bash
set -euo pipefail

# Harbor v3 Oracle Deployment Script
#
# Deploys/checks/verifies oracles (implementation + deterministic CREATE3 proxy via BaoFactory).
#
# Usage:
#   ./script/deploy-aggregators --network mainnet [options] <mode> [BASE/QUOTE ...]
#
# Examples:
#   ./script/deploy-aggregators --network mainnet --account HarborDeployer --deploy fxUSD/ETH fxUSD/BTC
#   ./script/deploy-aggregators --network mainnet --local --check fxUSD/ETH stETH/BTC
#   ./script/deploy-aggregators --network mainnet --etherscan-api-key $KEY --verify fxUSD/ETH

usage() {
  cat <<EOF
Usage:
  $0 --network <network> [options] <mode> [BASE/QUOTE ...]

Modes:
  --deploy         Deploy implementation + proxy via BaoFactory (full deployment)
  --deploy-impl    Deploy new implementation only (for upgrades; outputs Safe tx)
  --check          Verify deployment: checks code exists, calls oracleName/latestAnswer
  --verify-impl    Verify implementation contract on Etherscan
  --verify         Verify both implementation and proxy on Etherscan

Options:
  --network        Required. Network name (must match foundry.toml rpc_endpoints key)
  --local          Use local anvil RPC (enables auto-impersonate for operator/owner)
  --salt           Salt prefix for CREATE3 address (default: "harbor_v1")
  --account        Foundry keystore account name (required for non-local deploys)
  --etherscan-api-key  Required for --verify / --verify-impl / --check (non-local)

Oracle pairs:
  Positional arguments after the mode flag specify oracles as BASE/QUOTE pairs.
  Example: fxUSD/ETH fxUSD/BTC stETH/EUR

Contract resolution:
  Deploys: src/<network>/Aggregator_<base>_<quote>_<network>.sol:Aggregator_<base>_<quote>_<network>
  Salt:    <salt-prefix>::<base>::<quote>::wrappedPriceAggregator

State file:
  Deployments are recorded in deployments/<network>/v3-oracles[-<salt>].json
EOF
}

FORGE=forge
CAST=cast

BAO_FACTORY=0xD696E56b3A054734d4C6DCBD32E11a278b0EC458
OWNER=0x9bABfC1A1952a6ed2caC1922BFfE80c0506364a2

STATE_FILE=""
STATE_VERSION="v3"

RPC_NETWORK=""
NETWORK=""
USE_LOCAL=false
SALT_PREFIX="harbor_v1"
ACCOUNT_NAME=""
MODE=""
ETHERSCAN_API_KEY=""

ORACLES=()

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK=${2:-}
      shift 2
      ;;
    --local)
      USE_LOCAL=true
      shift
      ;;
    --rpc-url)
      echo "❌ --rpc-url is not supported; use --network (and --local to test on anvil)" >&2
      exit 1
      ;;
    --salt)
      SALT_PREFIX=${2:-}
      shift 2
      ;;
    --account)
      ACCOUNT_NAME=${2:-}
      shift 2
      ;;
    --etherscan-api-key)
      ETHERSCAN_API_KEY=${2:-}
      shift 2
      ;;
    --deploy)
      MODE="deploy"
      shift
      ;;
    --deploy-impl)
      MODE="deploy-impl"
      shift
      ;;
    --check)
      MODE="check"
      shift
      ;;
    --verify-impl | --veryify-impl)
      MODE="verify-impl"
      shift
      ;;
    --verify)
      MODE="verify"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "❌ Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      # Positional argument: oracle pair BASE/QUOTE
      ORACLES+=("$1")
      shift
      ;;
  esac
done

# ─────────────────────────────────────────────────────────────────────────────
# Validation
# ─────────────────────────────────────────────────────────────────────────────

if [[ ! -f "foundry.toml" ]] || [[ ! -d "src" ]] || [[ ! -d "script" ]]; then
  echo "❌ Must be run from the project root (missing foundry.toml/src/script)" >&2
  exit 1
fi

if [[ -z "$NETWORK" ]]; then
  echo "❌ Missing --network" >&2
  usage >&2
  exit 1
fi

if [[ "$NETWORK" == *"://"* ]] || [[ "$NETWORK" == ws://* ]] || [[ "$NETWORK" == wss://* ]]; then
  echo "❌ --network must be an rpc_endpoints name from foundry.toml, not a URL." >&2
  exit 1
fi

if [[ -z "$MODE" ]]; then
  echo "❌ Missing mode flag. Specify one of: --deploy, --deploy-impl, --check, --verify, --verify-impl" >&2
  usage >&2
  exit 1
fi

if [[ ${#ORACLES[@]} -eq 0 ]]; then
  echo "❌ No oracle pairs specified. Provide at least one BASE/QUOTE pair (e.g., fxUSD/ETH)" >&2
  usage >&2
  exit 1
fi

# Validate mode-specific requirements
if [[ "$MODE" == "check" ]]; then
  if [[ -z "$ETHERSCAN_API_KEY" ]] && [[ "$USE_LOCAL" == false ]]; then
    echo "❌ --etherscan-api-key is required for --check mode (unless --local)" >&2
    exit 1
  fi
  if [[ -n "$ACCOUNT_NAME" ]]; then
    echo "❌ --account should not be specified for --check mode" >&2
    exit 1
  fi
fi

if [[ "$USE_LOCAL" == true ]]; then
  RPC_NETWORK="local"
else
  RPC_NETWORK="$NETWORK"
fi

if [[ "$USE_LOCAL" != true ]] && [[ "$MODE" == "deploy" ]] && [[ -z "$ACCOUNT_NAME" ]]; then
  echo "❌ --account is required when deploying against $NETWORK" >&2
  exit 1
fi

if [[ "$USE_LOCAL" != true ]] && [[ "$MODE" == "deploy-impl" ]] && [[ -z "$ACCOUNT_NAME" ]]; then
  echo "❌ --account is required when deploying an implementation against $NETWORK" >&2
  exit 1
fi

# Prompt for password if account provided for deploy modes
PASSWORD=""
if [[ -n "$ACCOUNT_NAME" ]] && [[ "$MODE" == "deploy" || "$MODE" == "deploy-impl" ]]; then
  read -s -p "Enter password for account '$ACCOUNT_NAME': " PASSWORD
  echo ""
fi

SIGNER_ARGS=()
if [[ -n "$ACCOUNT_NAME" ]]; then
  SIGNER_ARGS=(--account "$ACCOUNT_NAME")
  if [[ -n "$PASSWORD" ]]; then
    SIGNER_ARGS+=(--password "$PASSWORD")
  fi
elif [[ "$USE_LOCAL" == true ]]; then
  SIGNER_ARGS=(--private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
fi

# Validate network name via ethers
if ! EXPECTED_NETWORK_NAME=$(node -e 'const { ethers } = require("ethers"); const n = ethers.Network.from(process.argv[1]); console.log(n.name);' "$NETWORK" 2>&1); then
  echo "❌ --network '$NETWORK' is not supported by ethers.Network.from(name)" >&2
  [[ -n "$EXPECTED_NETWORK_NAME" ]] && echo "   $EXPECTED_NETWORK_NAME" >&2
  exit 1
fi
if [[ "$EXPECTED_NETWORK_NAME" != "$NETWORK" ]]; then
  echo "❌ --network must match ethers canonical name exactly: got '$NETWORK', ethers resolved '$EXPECTED_NETWORK_NAME'" >&2
  exit 1
fi

if ! EXPECTED_CHAIN_ID=$(node -e 'const { ethers } = require("ethers"); const n = ethers.Network.from(process.argv[1]); console.log(n.chainId.toString());' "$NETWORK" 2>&1); then
  echo "❌ Failed to derive expected chainId for --network '$NETWORK'" >&2
  exit 1
fi

if ! CHAIN_ID=$("$CAST" chain-id --rpc-url "$RPC_NETWORK" 2>&1); then
  echo "❌ Failed to fetch chainId from --rpc-url '$RPC_NETWORK'" >&2
  [[ -n "$CHAIN_ID" ]] && echo "   $CHAIN_ID" >&2
  exit 1
fi
if [[ "$CHAIN_ID" != "$EXPECTED_CHAIN_ID" ]]; then
  echo "❌ ChainId mismatch: --network '$NETWORK' expects $EXPECTED_CHAIN_ID, but --rpc-url '$RPC_NETWORK' returned $CHAIN_ID" >&2
  exit 1
fi

# Set state file path in deployments/{network}/ with salt suffix
if [[ "$USE_LOCAL" == true ]]; then
  STATE_DIR="deployments/local"
else
  STATE_DIR="deployments/${NETWORK}"
fi
mkdir -p "$STATE_DIR"
if [[ "$SALT_PREFIX" == "harbor_v1" ]]; then
  STATE_FILE="${STATE_DIR}/v3-oracles.json"
else
  STATE_FILE="${STATE_DIR}/v3-oracles-${SALT_PREFIX}.json"
fi

# Only resolve DEPLOYER for modes that need it
DEPLOYER=""
if [[ "$MODE" == "deploy" || "$MODE" == "deploy-impl" ]] && [[ ${#SIGNER_ARGS[@]} -gt 0 ]]; then
  DEPLOYER=$("$CAST" wallet address "${SIGNER_ARGS[@]}")
fi

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

has_code() {
  local addr=$1
  local code
  code=$("$CAST" code "$addr" --rpc-url "$RPC_NETWORK" 2>/dev/null | head -n 1 || echo "0x")
  [[ "$code" != "0x" ]]
}

erc1967_impl_address() {
  local proxy=$1
  local slot=0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc
  local word
  word=$("$CAST" storage "$proxy" "$slot" --rpc-url "$RPC_NETWORK" 2>/dev/null)
  if [[ -z "$word" ]]; then
    echo ""
    return 1
  fi
  word=${word#0x}
  if [[ ${#word} -lt 40 ]]; then
    echo ""
    return 1
  fi
  echo "0x${word: -40}"
}

init_state_file() {
  if [[ -z "$STATE_FILE" ]]; then
    return
  fi
  if [[ ! -f "$STATE_FILE" ]]; then
    local base_obj
    base_obj=$(jq -n \
      --arg version "$STATE_VERSION" \
      --arg network "$NETWORK" \
      --arg chainId "$CHAIN_ID" \
      --arg baoFactory "$BAO_FACTORY" \
      '{
        version: $version,
        network: $network,
        chainId: ($chainId | tonumber),
        baoFactory: $baoFactory,
        implementations: {},
        proxies: {}
      }')

    if [[ "$SALT_PREFIX" != "harbor_v1" ]]; then
      base_obj=$(echo "$base_obj" | jq --arg salt "$SALT_PREFIX" '. + {saltPrefix: $salt}')
    fi

    echo "$base_obj" >"$STATE_FILE"
  fi
}

record_implementation() {
  local contract_name=$1
  local address=$2
  local timestamp
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  if [[ -z "$STATE_FILE" ]]; then
    return
  fi

  local tmp
  tmp=$(mktemp)
  jq \
    --arg name "$contract_name" \
    --arg addr "$address" \
    --arg ts "$timestamp" \
    '.implementations[$addr] = {contractName: $name, deployedAt: $ts}' \
    "$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
}

record_proxy() {
  local key=$1
  local salt=$2
  local address=$3
  local impl_address=$4
  local timestamp
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  if [[ -z "$STATE_FILE" ]]; then
    return
  fi

  local tmp
  tmp=$(mktemp)
  jq \
    --arg key "$key" \
    --arg salt "$salt" \
    --arg addr "$address" \
    --arg impl "$impl_address" \
    --arg ts "$timestamp" \
    '.proxies[$key] = {salt: $salt, address: $addr, implementation: $impl, deployedAt: $ts}' \
    "$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
}

deploy_implementation() {
  local contract_id=$1
  local contract_name=$2
  echo "  Deploying implementation: $contract_id" >&2
  out=$("$FORGE" create "$contract_id" --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --broadcast)

  impl=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$out" | awk '{print $3}')
  if [[ -z "$impl" ]]; then
    echo "  ❌ Failed to parse implementation address" >&2
    return 1
  fi

  echo "  ✓ Deployed: $impl" >&2
  record_implementation "$contract_name" "$impl"
  echo "$impl"
}

# Box drawing helpers
box_line() {
  printf '═%.0s' {1..60}
  echo
}

# ─────────────────────────────────────────────────────────────────────────────
# Validate oracle pairs and resolve contract paths
# ─────────────────────────────────────────────────────────────────────────────

declare -a ORACLE_BASES=()
declare -a ORACLE_QUOTES=()
declare -a ORACLE_KEYS=()
declare -a ORACLE_CONTRACTS=()
declare -a ORACLE_SRC_FILES=()

echo ""
box_line
echo "║  Harbor v3 Oracle Deployment"
echo "║  Network: $NETWORK (chainId: $CHAIN_ID)"
echo "║  Mode:    $MODE"
echo "║  Oracles: ${#ORACLES[@]}"
if [[ "$SALT_PREFIX" != "harbor_v1" ]]; then
  echo "║  Salt:    $SALT_PREFIX"
fi
box_line
echo ""

echo "── Validating oracle pairs ──────────────────────"
validation_failed=false

for pair in "${ORACLES[@]}"; do
  if [[ "$pair" != *"/"* ]]; then
    echo "  ❌ Invalid format: '$pair' (expected BASE/QUOTE)" >&2
    validation_failed=true
    continue
  fi

  IFS='/' read -r base quote <<<"$pair"

  if [[ -z "$base" ]] || [[ -z "$quote" ]]; then
    echo "  ❌ Invalid pair: '$pair' (empty base or quote)" >&2
    validation_failed=true
    continue
  fi

  key="${base}_${quote}"
  contract_name="Aggregator_${base}_${quote}_${NETWORK}"
  src_file="src/${NETWORK}/${contract_name}.sol"
  contract_id="${src_file}:${contract_name}"

  if [[ ! -f "$src_file" ]]; then
    echo "  ❌ Missing source: $src_file" >&2
    validation_failed=true
    continue
  fi

  if ! grep -Eq "^[[:space:]]*(abstract[[:space:]]+)?contract[[:space:]]+${contract_name}\b" "$src_file"; then
    echo "  ❌ Contract '${contract_name}' not found in $src_file" >&2
    validation_failed=true
    continue
  fi

  echo "  ✓ $pair → $contract_id"

  ORACLE_BASES+=("$base")
  ORACLE_QUOTES+=("$quote")
  ORACLE_KEYS+=("$key")
  ORACLE_CONTRACTS+=("$contract_id")
  ORACLE_SRC_FILES+=("$src_file")
done

if [[ "$validation_failed" == "true" ]]; then
  echo ""
  echo "❌ Validation failed. Aborting." >&2
  exit 1
fi
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# Check operator status (needed for --deploy mode)
# ─────────────────────────────────────────────────────────────────────────────

if [[ "$MODE" == "deploy" ]]; then
  echo "── BaoFactory ───────────────────────────────────"
  echo "  BaoFactory: $BAO_FACTORY"
  echo "  Deployer:   $DEPLOYER"
  echo "  Owner:      $OWNER"

  IS_OP=$("$CAST" call "$BAO_FACTORY" "isCurrentOperator(address)(bool)" "$DEPLOYER" --rpc-url "$RPC_NETWORK" 2>/dev/null)
  echo "  Operator:   $IS_OP"

  if [[ "$IS_OP" != "true" ]]; then
    set_operator_calldata=$("$CAST" calldata "setOperator(address,uint256)" "$DEPLOYER" 500000)

    if [[ "$USE_LOCAL" == true ]]; then
      echo ""
      echo "  Setting operator as OWNER (local mode)..."
      if ! "$CAST" send "$BAO_FACTORY" "setOperator(address,uint256)" "$DEPLOYER" 500000 \
        --from "$OWNER" --unlocked --rpc-url "$RPC_NETWORK" --json >/dev/null 2>&1; then
        echo "  ❌ Failed to call BaoFactory.setOperator as OWNER on local RPC." >&2
        echo "     Start anvil with --auto-impersonate and retry." >&2
        exit 1
      fi
      echo "  ✓ Operator set (pranked as $OWNER)"
    else
      echo ""
      echo "  ⚠ Deployer is not an operator. Before deploying, execute via Safe:"
      echo ""
      echo "  Safe Transaction Builder (setOperator):"
      echo "    To:        $BAO_FACTORY"
      echo "    Value:     0"
      echo "    Data:      $set_operator_calldata"
      echo "    Operation: CALL"
      echo ""
      echo "  ❌ Cannot proceed without operator status." >&2
      exit 1
    fi
  fi
  echo ""
fi

# ─────────────────────────────────────────────────────────────────────────────
# Process each oracle
# ─────────────────────────────────────────────────────────────────────────────

init_state_file

oracle_count=${#ORACLE_KEYS[@]}
oracle_num=0
fail=false

for i in "${!ORACLE_KEYS[@]}"; do
  ((oracle_num++)) || true

  BASE="${ORACLE_BASES[$i]}"
  QUOTE="${ORACLE_QUOTES[$i]}"
  KEY="${ORACLE_KEYS[$i]}"
  CONTRACT_ID="${ORACLE_CONTRACTS[$i]}"
  CONTRACT_NAME="Aggregator_${BASE}_${QUOTE}_${NETWORK}"

  salt_str="${SALT_PREFIX}::${BASE}::${QUOTE}::wrappedPriceAggregator"
  salt_b32=$("$CAST" keccak "$("$CAST" from-utf8 "$salt_str")")
  predicted=$("$CAST" call "$BAO_FACTORY" "predictAddress(bytes32)(address)" "$salt_b32" --rpc-url "$RPC_NETWORK")

  echo ""
  box_line
  echo "║  [$oracle_num/$oracle_count]  $BASE / $QUOTE"
  echo "║  Predicted: $predicted"
  box_line

  # ─────────────────────────────────────────────────────────────────────────
  # Mode: check
  # ─────────────────────────────────────────────────────────────────────────
  if [[ "$MODE" == "check" ]]; then
    if ! has_code "$predicted"; then
      echo "  ❌ Not deployed (no code)"
      fail=true
      continue
    fi

    if ! name=$("$CAST" call "$predicted" "oracleName()(string)" --rpc-url "$RPC_NETWORK" 2>&1); then
      echo "  ❌ oracleName() call failed"
      fail=true
      continue
    fi
    name=$(tr -d '"' <<<"$name")

    if ! latest_answer=$("$CAST" call "$predicted" "latestAnswer()(int256)" --rpc-url "$RPC_NETWORK" 2>&1); then
      echo "  ❌ latestAnswer() call failed"
      fail=true
      continue
    fi

    if [[ "$latest_answer" == "0" ]]; then
      echo "  ❌ latestAnswer() returned zero"
      fail=true
      continue
    fi

    echo "  ✅ Deployed"
    echo "     oracleName:   $name"
    echo "     latestAnswer: $latest_answer"
    continue
  fi

  # ─────────────────────────────────────────────────────────────────────────
  # Mode: verify-impl
  # ─────────────────────────────────────────────────────────────────────────
  if [[ "$MODE" == "verify-impl" ]]; then
    if [[ -z "$ETHERSCAN_API_KEY" ]]; then
      echo "  ❌ Missing --etherscan-api-key"
      fail=true
      continue
    fi

    if ! has_code "$predicted"; then
      echo "  ❌ Proxy not deployed (no code)"
      fail=true
      continue
    fi

    impl=$(erc1967_impl_address "$predicted")
    if [[ -z "$impl" ]] || [[ "${impl,,}" == "0x0000000000000000000000000000000000000000" ]]; then
      echo "  ❌ Failed to read implementation from proxy storage"
      fail=true
      continue
    fi

    echo "  Verifying implementation: $impl"
    if ! "$FORGE" verify-contract \
      "$impl" \
      "$CONTRACT_ID" \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --compiler-version 0.8.30 \
      --chain "$NETWORK"; then
      echo "  ❌ Verification failed"
      fail=true
      continue
    fi

    echo "  ✅ Implementation verified"
    continue
  fi

  # ─────────────────────────────────────────────────────────────────────────
  # Mode: verify
  # ─────────────────────────────────────────────────────────────────────────
  if [[ "$MODE" == "verify" ]]; then
    if [[ -z "$ETHERSCAN_API_KEY" ]]; then
      echo "  ❌ Missing --etherscan-api-key"
      fail=true
      continue
    fi

    proxy=$predicted

    if ! has_code "$proxy"; then
      echo "  ❌ Proxy not deployed (no code)"
      fail=true
      continue
    fi

    impl=$(erc1967_impl_address "$proxy")
    if [[ -z "$impl" ]] || [[ "${impl,,}" == "0x0000000000000000000000000000000000000000" ]]; then
      echo "  ❌ Failed to read implementation from proxy storage"
      fail=true
      continue
    fi

    # Verify implementation
    echo "  Verifying implementation: $impl"
    if ! "$FORGE" verify-contract \
      "$impl" \
      "$CONTRACT_ID" \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --compiler-version 0.8.30 \
      --chain "$NETWORK"; then
      echo "  ⚠ Implementation verification failed (continuing with proxy)"
    else
      echo "  ✓ Implementation verified"
    fi

    # Verify proxy
    local_init_data="0x"
    proxy_args=$("$CAST" abi-encode "constructor(address,bytes)" "$impl" "$local_init_data")

    echo "  Verifying proxy: $proxy"
    if ! "$FORGE" verify-contract \
      "$proxy" \
      lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --constructor-args "$proxy_args" \
      --compiler-version 0.8.30 \
      --chain "$NETWORK"; then
      echo "  ❌ Proxy verification failed"
      fail=true
      continue
    fi

    echo "  ✅ Verification complete"
    continue
  fi

  # ─────────────────────────────────────────────────────────────────────────
  # Mode: deploy-impl
  # ─────────────────────────────────────────────────────────────────────────
  if [[ "$MODE" == "deploy-impl" ]]; then
    impl=$(deploy_implementation "$CONTRACT_ID" "$CONTRACT_NAME")
    if [[ -z "$impl" ]]; then
      fail=true
      continue
    fi

    if ! has_code "$predicted"; then
      echo "  ❌ Proxy not deployed. Deploy the proxy first (use --deploy)"
      fail=true
      continue
    fi

    proxy_owner=$("$CAST" call "$predicted" "owner()(address)" --rpc-url "$RPC_NETWORK" 2>/dev/null)
    upgrade_calldata=$("$CAST" calldata "upgradeToAndCall(address,bytes)" "$impl" "0x")

    if [[ "$USE_LOCAL" == true ]]; then
      echo "  Upgrading proxy as OWNER (local mode)..."
      if ! "$CAST" send "$predicted" "upgradeToAndCall(address,bytes)" "$impl" "0x" \
        --from "$OWNER" --unlocked --rpc-url "$RPC_NETWORK" --json >/dev/null 2>&1; then
        echo "  ❌ Failed to upgrade"
        fail=true
        continue
      fi
      echo "  ✓ Proxy upgraded"

      new_impl=$(erc1967_impl_address "$predicted")
      echo "  New implementation: $new_impl"
    else
      echo ""
      echo "  Safe Transaction Builder (upgradeToAndCall):"
      echo "    To:        $predicted"
      echo "    Value:     0"
      echo "    Data:      $upgrade_calldata"
      echo "    Operation: CALL"
    fi

    echo "  ✅ Done"
    continue
  fi

  # ─────────────────────────────────────────────────────────────────────────
  # Mode: deploy (default)
  # ─────────────────────────────────────────────────────────────────────────
  if has_code "$predicted"; then
    current_impl=$(erc1967_impl_address "$predicted")
    name=$("$CAST" call "$predicted" "oracleName()(string)" --rpc-url "$RPC_NETWORK" 2>/dev/null | tr -d '"')
    echo "  ❌ Proxy already deployed at $predicted"
    echo "     oracleName: $name"
    echo "     Implementation: $current_impl"
    echo "     To upgrade, use: --deploy-impl"
    fail=true
    continue
  fi

  impl=$(deploy_implementation "$CONTRACT_ID" "$CONTRACT_NAME")
  if [[ -z "$impl" ]]; then
    fail=true
    continue
  fi

  echo "  Deploying proxy via BaoFactory..."

  # v3 oracles use BaoFixedOwnable (owner set via immutables), so no initialization call needed
  init_data="0x"

  proxy_bytecode=$("$FORGE" inspect ERC1967Proxy bytecode)
  proxy_args=$("$CAST" abi-encode "constructor(address,bytes)" "$impl" "$init_data")
  init_code="${proxy_bytecode}${proxy_args:2}"

  tx=$("$CAST" send "$BAO_FACTORY" "deploy(bytes,bytes32)(address)" "$init_code" "$salt_b32" \
    --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --json)

  tx_hash=$(jq -r '.transactionHash // empty' <<<"$tx" 2>/dev/null)
  if [[ -z "$tx_hash" ]]; then
    echo "  ❌ Failed to get transaction hash"
    fail=true
    continue
  fi
  echo "  ✓ Tx: $tx_hash"

  echo "  ⏳ Waiting for confirmation..."
  max_attempts=60
  attempt=0
  confirmed=false
  while [[ $attempt -lt $max_attempts ]]; do
    if receipt=$("$CAST" receipt "$tx_hash" --rpc-url "$RPC_NETWORK" --json 2>/dev/null); then
      status=$(jq -r '.status // empty' <<<"$receipt" 2>/dev/null)
      if [[ "$status" == "0x1" ]] || [[ "$status" == "1" ]]; then
        block=$(jq -r '.blockNumber // empty' <<<"$receipt" 2>/dev/null)
        echo "  ✓ Confirmed in block $block"
        confirmed=true
        break
      elif [[ "$status" == "0x0" ]] || [[ "$status" == "0" ]]; then
        echo "  ❌ Transaction reverted"
        fail=true
        break
      fi
    fi
    sleep 1
    ((++attempt))
  done

  if [[ "$confirmed" != "true" ]]; then
    if [[ $attempt -ge $max_attempts ]]; then
      echo "  ❌ Timeout waiting for confirmation"
    fi
    fail=true
    continue
  fi

  if ! has_code "$predicted"; then
    echo "  ❌ No code at predicted address after deployment"
    fail=true
    continue
  fi

  echo "  ✓ Deployed proxy: $predicted"
  record_proxy "$KEY" "$salt_str" "$predicted" "$impl"

  name=$("$CAST" call "$predicted" "oracleName()(string)" --rpc-url "$RPC_NETWORK" 2>/dev/null | tr -d '"')
  echo "  oracleName: $name"
  echo "  ✅ Done"
done

# ─────────────────────────────────────────────────────────────────────────────
# Summary
# ─────────────────────────────────────────────────────────────────────────────

echo ""
box_line
if [[ "$fail" == "true" ]]; then
  echo "║  ❌ One or more operations failed"
else
  echo "║  ✅ All $oracle_count oracles completed successfully"
fi
echo "║  State file: $STATE_FILE"
box_line

# ─────────────────────────────────────────────────────────────────────────────
# Generate markdown documentation after --check
# ─────────────────────────────────────────────────────────────────────────────

if [[ "$MODE" == "check" ]] && [[ -f "$STATE_FILE" ]]; then
  md_file="${STATE_FILE%.json}.md"
  network_name=$(jq -r '.network' "$STATE_FILE")
  chain_id=$(jq -r '.chainId' "$STATE_FILE")

  case "$network_name" in
    mainnet) explorer_url="https://etherscan.io" ;;
    arbitrum) explorer_url="https://arbiscan.io" ;;
    base) explorer_url="https://basescan.org" ;;
    *) explorer_url="https://etherscan.io" ;;
  esac

  check_proxy_status() {
    local address="$1"
    local api_key="$2"
    local cid="$3"
    if [[ -z "$api_key" ]]; then
      echo ""
      return
    fi
    local abi_response abi_status source_tick
    abi_response=$(curl -s "https://api.etherscan.io/v2/api?chainid=${cid}&module=contract&action=getabi&address=${address}&apikey=${api_key}")
    abi_status=$(echo "$abi_response" | jq -r '.status')
    if [[ "$abi_status" == "1" ]]; then source_tick='<span title="Source verified">✓</span>'; else source_tick='<span title="Source not verified">✗</span>'; fi
    local src_response result_count
    src_response=$(curl -s "https://api.etherscan.io/v2/api?chainid=${cid}&module=contract&action=getsourcecode&address=${address}&apikey=${api_key}")
    result_count=$(echo "$src_response" | jq '.result | length')
    if [[ "$result_count" != "1" ]]; then
      echo " ${source_tick}<span title=\"API error\">⚠⚠</span>"
      return
    fi
    local implementation impl_tick
    implementation=$(echo "$src_response" | jq -r '.result[0].Implementation')
    if [[ -n "$implementation" && "$implementation" != "null" && "$implementation" != "" ]]; then impl_tick='<span title="Implementation linked">✓</span>'; else impl_tick='<span title="Implementation not linked">✗</span>'; fi
    local proxy_flag proxy_tick
    proxy_flag=$(echo "$src_response" | jq -r '.result[0].Proxy')
    if [[ "$proxy_flag" == "1" ]]; then proxy_tick='<span title="Proxy flag set">✓</span>'; else proxy_tick='<span title="Proxy flag not set">✗</span>'; fi
    echo " ${source_tick}${impl_tick}${proxy_tick}"
  }

  check_impl_status() {
    local address="$1"
    local api_key="$2"
    local cid="$3"
    if [[ -z "$api_key" ]]; then
      echo ""
      return
    fi
    local response status
    response=$(curl -s "https://api.etherscan.io/v2/api?chainid=${cid}&module=contract&action=getabi&address=${address}&apikey=${api_key}")
    status=$(echo "$response" | jq -r '.status')
    if [[ "$status" == "1" ]]; then echo ' <span title="Source verified">✓</span>'; else echo ' <span title="Source not verified">✗</span>'; fi
  }

  {
    echo "# Harbor v3 Oracle Deployment Addresses"
    echo ""
    echo "Network: ${network_name} (chainId: ${chain_id})"
    echo ""
    echo "Generated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    echo ""
    echo "## Proxies"
    echo ""
    jq -r '.proxies | to_entries | sort_by(.key) | .[] | "\(.key)\t\(.value.address)\t\(.value.implementation)"' "$STATE_FILE" |
      while IFS=$'\t' read -r key proxy_addr impl_addr; do
        proxy_status=$(check_proxy_status "$proxy_addr" "$ETHERSCAN_API_KEY" "$chain_id")
        impl_status=$(check_impl_status "$impl_addr" "$ETHERSCAN_API_KEY" "$chain_id")
        echo "- [${key}](${explorer_url}/address/${proxy_addr}#code)"
        echo "  - [[verify proxy](${explorer_url}/proxyContractChecker?a=${proxy_addr})]${proxy_status} [[implementation](${explorer_url}/address/${impl_addr}#code)]${impl_status}"
      done
    echo ""
    echo "## Implementations"
    echo ""
    jq -r '.implementations | to_entries | sort_by(.value.contractName) | .[] | "\(.value.contractName)\t\(.key)"' "$STATE_FILE" |
      while IFS=$'\t' read -r contract_name impl_addr; do
        impl_status=$(check_impl_status "$impl_addr" "$ETHERSCAN_API_KEY" "$chain_id")
        echo "- [${contract_name}](${explorer_url}/address/${impl_addr}#code)${impl_status}"
      done
  } >"$md_file"

  echo ""
  echo "  Markdown: $md_file"
fi

if [[ "$fail" == "true" ]]; then
  exit 1
fi
