#!/usr/bin/env bash
set -euo pipefail

# Harbor Arbitrum Oracle Deployment Script
# Deploys PriceOracle library, sUSDE/USD oracle, and 8 stock price oracles

RPC_URL=${RPC_URL:-http://127.0.0.1:8545}
PRIVATE_KEY=${PRIVATE_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80}
OWNER=${OWNER:-0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266}

# Arbitrum contract addresses (placeholder - adjust as needed)
WSTETH=${WSTETH:-0x5979D7b546E38E414F7E9822514be443A4800529}  # Arbitrum wstETH
FXSAVE=${FXSAVE:-0x0000000000000000000000000000000000000000}  # Not used for stock oracles

# Chainlink feeds on Arbitrum
SUSDE_USDE_FEED=${SUSDE_USDE_FEED:-0x605EA726F0259a30db5b7c9ef39Df9fE78665C44}
USDE_USD_FEED=${USDE_USD_FEED:-0x88AC7Bca36567525A866138F03a6F6844868E0Bc}
WSTETH_STETH_FEED=${WSTETH_STETH_FEED:-0xB1552C5e96B312d0Bf8b554186F846C40614a540}
STETH_USD_FEED=${STETH_USD_FEED:-0x07C5b924399cc23c24a95c8743DE4006a32b7f2a}

# Stock price feeds on Arbitrum
AAPL_USD_FEED=${AAPL_USD_FEED:-0x8d0CC5f38f9E802475f2CFf4F9fc7000C2E1557c}
AMZN_USD_FEED=${AMZN_USD_FEED:-0xd6a77691f071E98Df7217BED98f38ae6d2313EBA}
GOOGL_USD_FEED=${GOOGL_USD_FEED:-0x1D1a83331e9D255EB1Aaf75026B60dFD00A252ba}
META_USD_FEED=${META_USD_FEED:-0xcd1bd86fDc33080DCF1b5715B6FCe04eC6F85845}
MSFT_USD_FEED=${MSFT_USD_FEED:-0xDde33fb9F21739602806580bdd73BAd831DcA867}
NVDA_USD_FEED=${NVDA_USD_FEED:-0x4881A4418b5F2460B21d6F08CD5aA0678a7f262F}
SPY_USD_FEED=${SPY_USD_FEED:-0x46306F3795342117721D8DEd50fbcF6DF2b3cc10}
TSLA_USD_FEED=${TSLA_USD_FEED:-0x3609baAa0a9b1f0FE4d6CC01884585d0e191C3E3}

# Constraints
MAX_AGE=${MAX_AGE:-604800}
MAX_DEV=${MAX_DEV:-50000000000000000}

echo "=== Deploying PriceOracle_v1 Library ==="
PRICE_ORACLE_LIB_OUT=$(forge create src/price/PriceOracle_v1.sol:PriceOracle_v1 \
  --rpc-url "$RPC_URL" \
  --private-key "$PRIVATE_KEY" \
  --broadcast)
PRICE_ORACLE_LIB=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$PRICE_ORACLE_LIB_OUT" | awk '{print $3}')
echo "  PriceOracle Library: $PRICE_ORACLE_LIB"

echo ""
echo "=== Deploying Implementation Contracts ==="

# 1. Deploy Single Feed Implementation
echo "Deploying HarborSingleFeedAndRateAggregator_v1..."
SINGLE_IMPL_OUT=$(forge create src/price/HarborSingleFeedAndRateAggregator_v1.sol:HarborSingleFeedAndRateAggregator_v1 \
  --rpc-url "$RPC_URL" \
  --private-key "$PRIVATE_KEY" \
  --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
  --broadcast \
  --constructor-args "$WSTETH" "$FXSAVE" "$SUSDE_USDE_FEED" "$WSTETH_STETH_FEED")
SINGLE_IMPL=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$SINGLE_IMPL_OUT" | awk '{print $3}')
echo "  Single Feed Implementation: $SINGLE_IMPL"

# 2. Deploy Double Feed Implementation
echo "Deploying HarborDoubleFeedAndRateAggregator_v1..."
DOUBLE_IMPL_OUT=$(forge create src/price/HarborDoubleFeedAndRateAggregator_v1.sol:HarborDoubleFeedAndRateAggregator_v1 \
  --rpc-url "$RPC_URL" \
  --private-key "$PRIVATE_KEY" \
  --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
  --broadcast \
  --constructor-args "$WSTETH" "$FXSAVE" "$SUSDE_USDE_FEED" "$WSTETH_STETH_FEED")
DOUBLE_IMPL=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$DOUBLE_IMPL_OUT" | awk '{print $3}')
echo "  Double Feed Implementation: $DOUBLE_IMPL"

# 3. Deploy Custom Feed Implementation
echo "Deploying HarborCustomFeedAndRateAggregator_v1..."
CUSTOM_IMPL_OUT=$(forge create src/price/HarborCustomFeedAndRateAggregator_v1.sol:HarborCustomFeedAndRateAggregator_v1 \
  --rpc-url "$RPC_URL" \
  --private-key "$PRIVATE_KEY" \
  --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
  --broadcast \
  --constructor-args "$WSTETH" "$FXSAVE" "$SUSDE_USDE_FEED" "$WSTETH_STETH_FEED")
CUSTOM_IMPL=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$CUSTOM_IMPL_OUT" | awk '{print $3}')
echo "  Custom Feed Implementation: $CUSTOM_IMPL"

echo ""
echo "=== Deploying Proxy Contracts ==="

# Helper function to deploy proxy
deploy_proxy() {
  local impl=$1
  local init_data=$2
  
  PROXY_OUT=$(forge create lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
    --rpc-url "$RPC_URL" \
    --private-key "$PRIVATE_KEY" \
    --broadcast \
    --constructor-args "$impl" "$init_data")
  PROXY=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$PROXY_OUT" | awk '{print $3}')
  echo "$PROXY"
}

# sUSDE to USD (Single Feed, RateSource=SUSDE_CHAINLINK=2, uses USDE/USD feed)
echo "--- sUSDE Oracle ---"
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToUSD" 2 "$USDE_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV")
SUSDE_USD=$(deploy_proxy "$SINGLE_IMPL" "$INIT_DATA")
echo "  sUSDE→USD: $SUSDE_USD"

# Stock Oracles (Double Feed: sUSDE/USD + Stock/USD)
echo ""
echo "--- Stock Price Oracles ---"

# sUSDE→AAPL (RateSource=SUSDE_CHAINLINK=2, first feed=USDE/USD, second feed=AAPL/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToAAPL" 2 "$USDE_USD_FEED" "$AAPL_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_AAPL=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→AAPL: $SUSDE_AAPL"

# sUSDE→AMZN (RateSource=SUSDE=2, first feed=USDE/USD, second feed=AMZN/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToAMZN" 2 "$USDE_USD_FEED" "$AMZN_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_AMZN=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→AMZN: $SUSDE_AMZN"

# sUSDE→GOOGL (RateSource=SUSDE=2, first feed=USDE/USD, second feed=GOOGL/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToGOOGL" 2 "$USDE_USD_FEED" "$GOOGL_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_GOOGL=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→GOOGL: $SUSDE_GOOGL"

# sUSDE→META (RateSource=SUSDE=2, first feed=USDE/USD, second feed=META/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToMETA" 2 "$USDE_USD_FEED" "$META_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_META=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→META: $SUSDE_META"

# sUSDE→MSFT (RateSource=SUSDE=2, first feed=USDE/USD, second feed=MSFT/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToMSFT" 2 "$USDE_USD_FEED" "$MSFT_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_MSFT=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→MSFT: $SUSDE_MSFT"

# sUSDE→NVDA (RateSource=SUSDE=2, first feed=USDE/USD, second feed=NVDA/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToNVDA" 2 "$USDE_USD_FEED" "$NVDA_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_NVDA=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→NVDA: $SUSDE_NVDA"

# sUSDE→SPY (RateSource=SUSDE=2, first feed=USDE/USD, second feed=SPY/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToSPY" 2 "$USDE_USD_FEED" "$SPY_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_SPY=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→SPY: $SUSDE_SPY"

# sUSDE→TSLA (RateSource=SUSDE=2, first feed=USDE/USD, second feed=TSLA/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToTSLA" 2 "$USDE_USD_FEED" "$TSLA_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
SUSDE_TSLA=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  sUSDE→TSLA: $SUSDE_TSLA"

# wstETH Oracles (Double Feed: stETH/USD + Stock/USD)
echo ""
echo "--- wstETH Price Oracles ---"

# wstETH→USD (Single Feed, RateSource=WSTETH_CHAINLINK=3, uses stETH/USD feed)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToUSD" 3 "$STETH_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV")
WSTETH_USD=$(deploy_proxy "$SINGLE_IMPL" "$INIT_DATA")
echo "  wstETH→USD: $WSTETH_USD"

# wstETH→AAPL (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=AAPL/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToAAPL" 3 "$STETH_USD_FEED" "$AAPL_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_AAPL=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→AAPL: $WSTETH_AAPL"

# wstETH→AMZN (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=AMZN/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToAMZN" 3 "$STETH_USD_FEED" "$AMZN_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_AMZN=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→AMZN: $WSTETH_AMZN"

# wstETH→GOOGL (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=GOOGL/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToGOOGL" 3 "$STETH_USD_FEED" "$GOOGL_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_GOOGL=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→GOOGL: $WSTETH_GOOGL"

# wstETH→META (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=META/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToMETA" 3 "$STETH_USD_FEED" "$META_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_META=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→META: $WSTETH_META"

# wstETH→MSFT (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=MSFT/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToMSFT" 3 "$STETH_USD_FEED" "$MSFT_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_MSFT=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→MSFT: $WSTETH_MSFT"

# wstETH→NVDA (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=NVDA/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToNVDA" 3 "$STETH_USD_FEED" "$NVDA_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_NVDA=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→NVDA: $WSTETH_NVDA"

# wstETH→SPY (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=SPY/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToSPY" 3 "$STETH_USD_FEED" "$SPY_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_SPY=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→SPY: $WSTETH_SPY"

# wstETH→TSLA (RateSource=WSTETH_CHAINLINK=3, first feed=stETH/USD, second feed=TSLA/USD)
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToTSLA" 3 "$STETH_USD_FEED" "$TSLA_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_TSLA=$(deploy_proxy "$DOUBLE_IMPL" "$INIT_DATA")
echo "  wstETH→TSLA: $WSTETH_TSLA"

# wstETH→Aggregated Stocks (Custom Feed: aggregates AAPL, GOOGL, NVDA, AMZN, MSFT, META, divides by 6 for average)
echo ""
echo "--- wstETH Custom Feed Oracle ---"
# Use STETH/USD as the USD feed for final conversion
USD_FEED_FOR_CUSTOM=${USD_FEED_FOR_CUSTOM:-$STETH_USD_FEED}
AGGREGATION_DIVISOR=${AGGREGATION_DIVISOR:-6}

# Use cast calldata with array syntax - cast should handle arrays correctly
INIT_DATA=$(cast calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToT6CH" 3 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED]" "$USD_FEED_FOR_CUSTOM" "$AGGREGATION_DIVISOR" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
WSTETH_AGGREGATED=$(deploy_proxy "$CUSTOM_IMPL" "$INIT_DATA")
echo "  wstETH→T6CH (AAPL+GOOGL+NVDA+AMZN+MSFT+META/6): $WSTETH_AGGREGATED"

echo ""
echo "=== DEPLOYMENT SUMMARY ==="
echo ""
echo "LIBRARY:"
echo "  PriceOracle_v1: $PRICE_ORACLE_LIB"
echo ""
echo "IMPLEMENTATIONS:"
echo "  Single Feed: $SINGLE_IMPL"
echo "  Double Feed: $DOUBLE_IMPL"
echo "  Custom Feed: $CUSTOM_IMPL"
echo ""
echo "ORACLES:"
echo "  sUSDE→USD:  $SUSDE_USD"
echo "  sUSDE→AAPL: $SUSDE_AAPL"
echo "  sUSDE→AMZN: $SUSDE_AMZN"
echo "  sUSDE→GOOGL: $SUSDE_GOOGL"
echo "  sUSDE→META: $SUSDE_META"
echo "  sUSDE→MSFT: $SUSDE_MSFT"
echo "  sUSDE→NVDA: $SUSDE_NVDA"
echo "  sUSDE→SPY:  $SUSDE_SPY"
echo "  sUSDE→TSLA: $SUSDE_TSLA"
echo ""
echo "  wstETH→USD:  $WSTETH_USD"
echo "  wstETH→AAPL: $WSTETH_AAPL"
echo "  wstETH→AMZN: $WSTETH_AMZN"
echo "  wstETH→GOOGL: $WSTETH_GOOGL"
echo "  wstETH→META: $WSTETH_META"
echo "  wstETH→MSFT: $WSTETH_MSFT"
echo "  wstETH→NVDA: $WSTETH_NVDA"
echo "  wstETH→SPY:  $WSTETH_SPY"
echo "  wstETH→TSLA: $WSTETH_TSLA"
echo ""
echo "CUSTOM FEED ORACLES:"
echo "  wstETH→T6CH: $WSTETH_AGGREGATED"

# Test price readouts
echo ""
echo "=== PRICE READOUTS ==="
echo "sUSDE:"
echo -n "  sUSDE→USD:  "
cast call "$SUSDE_USD" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"

echo ""
echo "Stock Oracles:"
echo "sUSDE:"
echo -n "  sUSDE→AAPL: "
cast call "$SUSDE_AAPL" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→AMZN: "
cast call "$SUSDE_AMZN" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→GOOGL: "
cast call "$SUSDE_GOOGL" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→META: "
cast call "$SUSDE_META" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→MSFT: "
cast call "$SUSDE_MSFT" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→NVDA: "
cast call "$SUSDE_NVDA" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→SPY:  "
cast call "$SUSDE_SPY" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  sUSDE→TSLA: "
cast call "$SUSDE_TSLA" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"

echo ""
echo "wstETH:"
echo -n "  wstETH→USD:  "
cast call "$WSTETH_USD" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→AAPL: "
cast call "$WSTETH_AAPL" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→AMZN: "
cast call "$WSTETH_AMZN" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→GOOGL: "
cast call "$WSTETH_GOOGL" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→META: "
cast call "$WSTETH_META" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→MSFT: "
cast call "$WSTETH_MSFT" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→NVDA: "
cast call "$WSTETH_NVDA" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→SPY:  "
cast call "$WSTETH_SPY" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"
echo -n "  wstETH→TSLA: "
cast call "$WSTETH_TSLA" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"

echo ""
echo "Custom Feed Oracle:"
echo -n "  wstETH→T6CH: "
cast call "$WSTETH_AGGREGATED" "getPrice()(uint256)" --rpc-url "$RPC_URL" 2>/dev/null || echo "N/A"

echo ""
echo "✅ Deployment complete!"

