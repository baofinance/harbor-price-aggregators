done

# Verify sUSDE→MAG7 (Custom Feed) - regenerate init data
INIT_DATA_SUSDE_MAG7_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "sUSDEToMAG7" 2 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_SUSDE_CUSTOM" "$AGGREGATION_DIVISOR_SUSDE" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
PROXY_CONSTRUCTOR_ARGS_SUSDE_MAG7=$("$CAST" abi-encode "constructor(address,bytes)" "$CUSTOM_IMPL" "$INIT_DATA_SUSDE_MAG7_VERIFY")
echo "# Verify sUSDE→MAG7 proxy (Custom Feed):"
echo "$FORGE verify-contract \\"
echo "  $SUSDE_MAG7 \\"
echo "  lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \\"
echo "  --verifier etherscan \\"
echo "  --etherscan-api-key $ETHERSCAN_KEY_PLACEHOLDER \\"
echo "  --constructor-args $PROXY_CONSTRUCTOR_ARGS_SUSDE_MAG7 \\"
echo "  --compiler-version 0.8.30 \\"
echo "  --chain arbitrum"
echo ""

# Verify wstETH→USD (Single Feed) - regenerate init data
INIT_DATA_WSTETH_USD_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToUSD" 3 "$STETH_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV")
PROXY_CONSTRUCTOR_ARGS_WSTETH_USD=$("$CAST" abi-encode "constructor(address,bytes)" "$SINGLE_IMPL" "$INIT_DATA_WSTETH_USD_VERIFY")
