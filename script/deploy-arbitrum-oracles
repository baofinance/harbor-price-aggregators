# Initialize variables to avoid unbound variable errors
PRICE_ORACLE_LIB="${PRICE_ORACLE_LIB:-0x07f347B979fCE7cD7Bb761fEda6bd7Dfea19a6A5}"
SINGLE_IMPL="${SINGLE_IMPL:-}"
DOUBLE_IMPL="${DOUBLE_IMPL:-}"
CUSTOM_IMPL="${CUSTOM_IMPL:-}"
USDE_USD="${USDE_USD:-}"
USDE_AAPL="${USDE_AAPL:-}"
