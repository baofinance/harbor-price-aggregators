# Retry mode: Initialize any uninitialized proxies
if [[ "$MODE" == "retry" ]] || [[ "$MODE" == "init" ]]; then
  echo ""
  echo "=== RETRY MODE: Initializing uninitialized contracts ==="
  
  # Regenerate init data if needed (for standalone retry mode)
  if [[ -z "${INIT_DATA_USDE_USD:-}" ]]; then
    INIT_DATA_USDE_USD=$("$CAST" calldata "initialize(address,string,uint8,address,uint256,uint64,uint256,bool)" \
      "$OWNER" "USDEToUSD" 2 "$USDE_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" false)
  fi
  initialize_proxy "$USDE_USD" "USDE→USD" "$INIT_DATA_USDE_USD" || true
  
  # Regenerate stock oracle init data
  for i in "${!USDE_STOCKS[@]}"; do
    stock="${USDE_STOCKS[$i]}"
    feed="${USDE_STOCK_FEEDS[$i]}"
    var_name="${USDE_STOCK_VARS[$i]}"
    proxy_addr=$(eval echo \$$var_name)
    init_data=$("$CAST" calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256,bool)" \
      "$OWNER" "USDETo${stock}" 2 "$USDE_USD_FEED" "$feed" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV" false)
    initialize_proxy "$proxy_addr" "USDE→${stock}" "$init_data" || true
  done
  
  if [[ -z "${INIT_DATA_USDE_MAG7:-}" ]]; then
    INIT_DATA_USDE_MAG7=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256,bool)" \
      "$OWNER" "USDEToMAG7" 2 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_SUSDE_CUSTOM" "$AGGREGATION_DIVISOR_SUSDE" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV" false)
  fi
  initialize_proxy "$USDE_MAG7" "USDE→MAG7" "$INIT_DATA_USDE_MAG7" || true
  
  if [[ -z "${INIT_DATA_STETH_USD:-}" ]]; then
    INIT_DATA_STETH_USD=$("$CAST" calldata "initialize(address,string,uint8,address,uint256,uint64,uint256,bool)" \
      "$OWNER" "stETHToUSD" 3 "$STETH_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV" false)
  fi
  initialize_proxy "$STETH_USD" "stETH→USD" "$INIT_DATA_STETH_USD" || true
  
  for i in "${!STETH_STOCKS[@]}"; do
    stock="${STETH_STOCKS[$i]}"
    feed="${STETH_STOCK_FEEDS[$i]}"
    var_name="${STETH_STOCK_VARS[$i]}"
    proxy_addr=$(eval echo \$$var_name)
    init_data=$("$CAST" calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256,bool)" \
      "$OWNER" "stETHTo${stock}" 3 "$STETH_USD_FEED" "$feed" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV" false)
    initialize_proxy "$proxy_addr" "stETH→${stock}" "$init_data" || true
  done
  
  if [[ -z "${INIT_DATA_STETH_MAG7:-}" ]]; then
    INIT_DATA_STETH_MAG7=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256,bool)" \
      "$OWNER" "stETHToMAG7" 3 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_CUSTOM" "$AGGREGATION_DIVISOR" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV" false)
  fi
  initialize_proxy "$STETH_MAG7" "stETH→MAG7" "$INIT_DATA_STETH_MAG7" || true
  
  echo ""
  echo "=== Checking final status ==="
  check_all_deployments
fi

# Configure rate source staleness (skip if SKIP_RATE_CONFIG is set)
if [[ "${SKIP_RATE_CONFIG:-}" != "true" ]]; then
  echo ""
  echo "=== CONFIGURING RATE SOURCE STALENESS ==="
  echo "Setting maxRateSourceAge to ${MAX_RATE_SOURCE_AGE} seconds for Chainlink rate source oracles..."
  
  set_max_rate_source_age() {
    local oracle=$1
    local name=$2
    
    echo -n "  Setting $name... "
    "$CAST" send "$oracle" "setMaxRateSourceAge(uint64)" "$MAX_RATE_SOURCE_AGE" \
      --rpc-url "$RPC_URL" \
      --private-key "$PRIVATE_KEY" > /dev/null 2>&1 && echo "✓" || echo "✗"
  }
  
  echo ""
  echo "USDE Oracles (RateSource=SUSDE_CHAINLINK):"
  set_max_rate_source_age "$USDE_USD" "USDE→USD"
  set_max_rate_source_age "$USDE_AAPL" "USDE→AAPL"
  set_max_rate_source_age "$USDE_AMZN" "USDE→AMZN"
  set_max_rate_source_age "$USDE_GOOGL" "USDE→GOOGL"
  set_max_rate_source_age "$USDE_META" "USDE→META"
  set_max_rate_source_age "$USDE_MSFT" "USDE→MSFT"
  set_max_rate_source_age "$USDE_NVDA" "USDE→NVDA"
  set_max_rate_source_age "$USDE_SPY" "USDE→SPY"
  set_max_rate_source_age "$USDE_TSLA" "USDE→TSLA"
  
  echo ""
  echo "stETH Oracles (RateSource=WSTETH_CHAINLINK):"
  set_max_rate_source_age "$STETH_USD" "stETH→USD"
  set_max_rate_source_age "$STETH_AAPL" "stETH→AAPL"
  set_max_rate_source_age "$STETH_AMZN" "stETH→AMZN"
  set_max_rate_source_age "$STETH_GOOGL" "stETH→GOOGL"
  set_max_rate_source_age "$STETH_META" "stETH→META"
  set_max_rate_source_age "$STETH_MSFT" "stETH→MSFT"
  set_max_rate_source_age "$STETH_NVDA" "stETH→NVDA"
  set_max_rate_source_age "$STETH_SPY" "stETH→SPY"
  set_max_rate_source_age "$STETH_TSLA" "stETH→TSLA"
  set_max_rate_source_age "$STETH_MAG7" "stETH→MAG7"
  set_max_rate_source_age "$USDE_MAG7" "USDE→MAG7"
else
  echo ""
  echo "⏭️  Skipping rate source staleness configuration (SKIP_RATE_CONFIG=true)"
fi

