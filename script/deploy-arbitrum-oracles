# Helper function to save state
save_state() {
  local state_json=$(cat <<EOF
{
  "library": "${PRICE_ORACLE_LIB:-}",
  "implementations": {
    "SINGLE": "${SINGLE_IMPL:-}",
    "DOUBLE": "${DOUBLE_IMPL:-}",
    "CUSTOM": "${CUSTOM_IMPL:-}"
  },
  "proxies": {
    "USDE_USD": "${USDE_USD:-}",
    "USDE_AAPL": "${USDE_AAPL:-}",
    "USDE_AMZN": "${USDE_AMZN:-}",
    "USDE_GOOGL": "${USDE_GOOGL:-}",
    "USDE_META": "${USDE_META:-}",
    "USDE_MSFT": "${USDE_MSFT:-}",
    "USDE_NVDA": "${USDE_NVDA:-}",
    "USDE_SPY": "${USDE_SPY:-}",
    "USDE_TSLA": "${USDE_TSLA:-}",
    "USDE_MAG7": "${USDE_MAG7:-}",
    "STETH_USD": "${STETH_USD:-}",
    "STETH_AAPL": "${STETH_AAPL:-}",
    "STETH_AMZN": "${STETH_AMZN:-}",
    "STETH_GOOGL": "${STETH_GOOGL:-}",
    "STETH_META": "${STETH_META:-}",
    "STETH_MSFT": "${STETH_MSFT:-}",
    "STETH_NVDA": "${STETH_NVDA:-}",
    "STETH_SPY": "${STETH_SPY:-}",
    "STETH_TSLA": "${STETH_TSLA:-}",
    "STETH_MAG7": "${STETH_MAG7:-}"
  },
  "deployment_time": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
)
  echo "$state_json" > "$STATE_FILE"
  echo "✓ State saved to $STATE_FILE"
}

# Helper function to load state
load_state() {
  if [[ -f "$STATE_FILE" ]]; then
    echo "📂 Loading state from $STATE_FILE"
    local val=$(jq -r '.library // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && PRICE_ORACLE_LIB="$val"
    
    val=$(jq -r '.implementations.SINGLE // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && SINGLE_IMPL="$val"
    
    val=$(jq -r '.implementations.DOUBLE // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && DOUBLE_IMPL="$val"
    
    val=$(jq -r '.implementations.CUSTOM // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && CUSTOM_IMPL="$val"
    
    # Load all proxy addresses (with backward compatibility for old names)
    for proxy_name in USDE_USD USDE_AAPL USDE_AMZN USDE_GOOGL USDE_META USDE_MSFT USDE_NVDA USDE_SPY USDE_TSLA USDE_MAG7 \
                      STETH_USD STETH_AAPL STETH_AMZN STETH_GOOGL STETH_META STETH_MSFT STETH_NVDA STETH_SPY STETH_TSLA STETH_MAG7; do
      # Try new name first, then fall back to old name for backward compatibility
      val=$(jq -r ".proxies.$proxy_name // empty" "$STATE_FILE" 2>/dev/null || echo "")
      if [[ -z "$val" ]] || [[ "$val" == "null" ]]; then
        # Try old name for backward compatibility
        old_name="${proxy_name/USDE_/SUSDE_}"
        old_name="${old_name/STETH_/WSTETH_}"
        val=$(jq -r ".proxies.$old_name // empty" "$STATE_FILE" 2>/dev/null || echo "")
      fi
      if [[ -n "$val" ]] && [[ "$val" != "null" ]]; then
        eval "${proxy_name}=\"$val\""
      fi
    done
    
    return 0
  else
    return 1
  fi
}

# Helper function to check if contract is initialized
check_initialized() {
  local proxy=$1
  local name=$2
  
  if [[ -z "$proxy" ]] || [[ "$proxy" == "null" ]] || [[ "$proxy" == "" ]]; then
    echo "❌ $name: Not deployed"
    return 1
  fi
  
  local code=$("$CAST" code "$proxy" --rpc-url "$RPC_URL" 2>/dev/null | head -1)
  if [[ "$code" == "0x" ]]; then
    echo "❌ $name ($proxy): No code at address"
    return 1
  fi
  
  local oracle_name=$("$CAST" call "$proxy" "oracleName()(string)" --rpc-url "$RPC_URL" 2>/dev/null || echo "")
  if [[ -n "$oracle_name" ]] && [[ "$oracle_name" != "" ]]; then
    echo "✅ $name ($proxy): Initialized (name: $oracle_name)"
    return 0
  else
    echo "⚠️  $name ($proxy): Deployed but NOT initialized"
    return 1
  fi
}

# Function to manually initialize a proxy
initialize_proxy() {
  local proxy=$1
  local name=$2
  local init_data=$3
  
  echo "🔧 Initializing $name ($proxy)..."
  
  # Check if already initialized
  local oracle_name=$("$CAST" call "$proxy" "oracleName()(string)" --rpc-url "$RPC_URL" 2>/dev/null || echo "")
  if [[ -n "$oracle_name" ]] && [[ "$oracle_name" != "" ]]; then
    echo "  ✓ Already initialized (name: $oracle_name)"
    return 0
  fi
  
  # Send initialization transaction
  local tx_hash=$("$CAST" send "$proxy" "$init_data" --rpc-url "$RPC_URL" --private-key "$PRIVATE_KEY" --json 2>/dev/null | jq -r '.transactionHash // empty' || echo "")
  
  if [[ -n "$tx_hash" ]] && [[ "$tx_hash" != "null" ]] && [[ "$tx_hash" != "" ]]; then
    echo "  ✓ Initialization tx: $tx_hash"
    echo "  ⏳ Waiting for confirmation..."
    sleep 5
    
    # Verify initialization
    local verify_name=$("$CAST" call "$proxy" "oracleName()(string)" --rpc-url "$RPC_URL" 2>/dev/null || echo "")
    if [[ -n "$verify_name" ]] && [[ "$verify_name" != "" ]]; then
      echo "  ✅ Successfully initialized"
      return 0
    else
      echo "  ⚠️  Transaction sent but verification failed. Check manually."
      return 1
    fi
  else
    echo "  ❌ Failed to send initialization transaction"
    return 1
  fi
}

# Function to check all deployments
check_all_deployments() {
  echo "=== CHECKING DEPLOYMENT STATUS ==="
  echo ""
  
  if ! load_state; then
    echo "❌ No state file found: $STATE_FILE"
    echo "   Run with MODE=deploy to start deployment"
    return 1
  fi
  
  echo "Library: ${PRICE_ORACLE_LIB:-not set}"
  echo "Implementations: Single=${SINGLE_IMPL:-not set}, Double=${DOUBLE_IMPL:-not set}, Custom=${CUSTOM_IMPL:-not set}"
  echo ""
  
  local all_ok=true
  
  check_initialized "$USDE_USD" "USDE→USD" || all_ok=false
  check_initialized "$USDE_AAPL" "USDE→AAPL" || all_ok=false
  check_initialized "$USDE_AMZN" "USDE→AMZN" || all_ok=false
  check_initialized "$USDE_GOOGL" "USDE→GOOGL" || all_ok=false
  check_initialized "$USDE_META" "USDE→META" || all_ok=false
  check_initialized "$USDE_MSFT" "USDE→MSFT" || all_ok=false
  check_initialized "$USDE_NVDA" "USDE→NVDA" || all_ok=false
  check_initialized "$USDE_SPY" "USDE→SPY" || all_ok=false
  check_initialized "$USDE_TSLA" "USDE→TSLA" || all_ok=false
  check_initialized "$USDE_MAG7" "USDE→MAG7" || all_ok=false
  check_initialized "$STETH_USD" "stETH→USD" || all_ok=false
  check_initialized "$STETH_AAPL" "stETH→AAPL" || all_ok=false
  check_initialized "$STETH_AMZN" "stETH→AMZN" || all_ok=false
  check_initialized "$STETH_GOOGL" "stETH→GOOGL" || all_ok=false
  check_initialized "$STETH_META" "stETH→META" || all_ok=false
  check_initialized "$STETH_MSFT" "stETH→MSFT" || all_ok=false
  check_initialized "$STETH_NVDA" "stETH→NVDA" || all_ok=false
  check_initialized "$STETH_SPY" "stETH→SPY" || all_ok=false
  check_initialized "$STETH_TSLA" "stETH→TSLA" || all_ok=false
  check_initialized "$STETH_MAG7" "stETH→MAG7" || all_ok=false
  
  echo ""
  if [[ "$all_ok" == "true" ]]; then
    echo "✅ All contracts are deployed and initialized!"
  else
    echo "⚠️  Some contracts need attention. Run with MODE=retry to initialize missing contracts."
  fi
  
  return 0
}

