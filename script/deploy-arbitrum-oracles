# Verify wstETH stock oracles (Double Feed)
for i in "${!WSTETH_STOCKS[@]}"; do
  stock="${WSTETH_STOCKS[$i]}"
  var_name="${WSTETH_STOCK_VARS[$i]}"
  proxy_addr=$(eval echo \$$var_name)
  feed="${WSTETH_STOCK_FEEDS[$i]}"
  
  # Regenerate init data for verification
  init_data=$("$CAST" calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
    "$OWNER" "wstETHTo${stock}" 3 "$STETH_USD_FEED" "$feed" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
  
  PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$DOUBLE_IMPL" "$init_data")
  echo "# Verify wstETH→${stock} proxy:"
  echo "$FORGE verify-contract \\"
  echo "  $proxy_addr \\"
  echo "  lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \\"
  echo "  --verifier etherscan \\"
  echo "  --etherscan-api-key $ETHERSCAN_KEY_PLACEHOLDER \\"
  echo "  --constructor-args $PROXY_ARGS \\"
  echo "  --compiler-version 0.8.30 \\"
  echo "  --chain arbitrum"
  echo ""
done

# Verify wstETH→MAG7 (Custom Feed) - regenerate init data
INIT_DATA_WSTETH_MAG7_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256)" \
  "$OWNER" "wstETHToMAG7" 3 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_CUSTOM" "$AGGREGATION_DIVISOR" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
PROXY_CONSTRUCTOR_ARGS_WSTETH_MAG7=$("$CAST" abi-encode "constructor(address,bytes)" "$CUSTOM_IMPL" "$INIT_DATA_WSTETH_MAG7_VERIFY")
echo "# Verify wstETH→MAG7 proxy (Custom Feed):"
echo "$FORGE verify-contract \\"
echo "  $WSTETH_MAG7 \\"
echo "  lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \\"
echo "  --verifier etherscan \\"
echo "  --etherscan-api-key $ETHERSCAN_KEY_PLACEHOLDER \\"
echo "  --constructor-args $PROXY_CONSTRUCTOR_ARGS_WSTETH_MAG7 \\"
echo "  --compiler-version 0.8.30 \\"
echo "  --chain arbitrum"
echo ""
