declare -a STETH_STOCK_VARS=("STETH_AAPL" "STETH_AMZN" "STETH_GOOGL" "STETH_META" "STETH_MSFT" "STETH_NVDA" "STETH_SPY" "STETH_TSLA")

# Additional variables for custom feeds
USD_FEED_FOR_SUSDE_CUSTOM=${USD_FEED_FOR_SUSDE_CUSTOM:-$USDE_USD_FEED}
AGGREGATION_DIVISOR_SUSDE=${AGGREGATION_DIVISOR_SUSDE:-7}
USD_FEED_FOR_CUSTOM=${USD_FEED_FOR_CUSTOM:-$STETH_USD_FEED}
AGGREGATION_DIVISOR=${AGGREGATION_DIVISOR:-7}

# Handle different modes
if [[ "$MODE" == "check" ]]; then
  check_all_deployments
  exit 0
fi

if [[ "$MODE" == "verify-impl" ]] || [[ "$MODE" == "verify-implementations" ]]; then
  # Load state first (optional - can use manual overrides)
  load_state || true
  
  # Allow manual override of implementation addresses
  if [[ -n "${MANUAL_SINGLE_IMPL:-}" ]]; then
    SINGLE_IMPL="$MANUAL_SINGLE_IMPL"
  fi
  if [[ -n "${MANUAL_DOUBLE_IMPL:-}" ]]; then
    DOUBLE_IMPL="$MANUAL_DOUBLE_IMPL"
  fi
  if [[ -n "${MANUAL_CUSTOM_IMPL:-}" ]]; then
    CUSTOM_IMPL="$MANUAL_CUSTOM_IMPL"
  fi
  
  # Check if ETHERSCAN_API_KEY is set
  if [[ -z "$ETHERSCAN_API_KEY" ]]; then
    echo "❌ ETHERSCAN_API_KEY is not set. Cannot verify contracts."
    exit 1
  fi
  
  # Check if we have at least one implementation address
  if [[ -z "$SINGLE_IMPL" ]] && [[ -z "$DOUBLE_IMPL" ]] && [[ -z "$CUSTOM_IMPL" ]]; then
    echo "❌ No implementation addresses found."
    echo "   Either load from state file or set MANUAL_SINGLE_IMPL, MANUAL_DOUBLE_IMPL, and/or MANUAL_CUSTOM_IMPL"
    exit 1
  fi
  
  echo "=== VERIFYING IMPLEMENTATION CONTRACTS ON ARBISCAN (V2) ==="
  echo ""
  
  # Arbitrum contract addresses (needed for constructor)
  WSTETH=${WSTETH:-0x5979D7b546E38E414F7E9822514be443A4800529}
  FXSAVE=${FXSAVE:-0x0000000000000000000000000000000000000000}
  SUSDE_USDE_FEED=${SUSDE_USDE_FEED:-0x605EA726F0259a30db5b7c9ef39Df9fE78665C44}
  WSTETH_STETH_FEED=${WSTETH_STETH_FEED:-0xB1552C5e96B312d0Bf8b554186F846C40614a540}
  
  # Pre-compute constructor args for implementations
  IMPL_CONSTRUCTOR_ARGS=$("$CAST" abi-encode "constructor(address,address,address,address)" "$WSTETH" "$FXSAVE" "$SUSDE_USDE_FEED" "$WSTETH_STETH_FEED")
  
  COUNT=0
  TOTAL=0
  [[ -n "$SINGLE_IMPL" ]] && TOTAL=$((TOTAL + 1))
  [[ -n "$DOUBLE_IMPL" ]] && TOTAL=$((TOTAL + 1))
  [[ -n "$CUSTOM_IMPL" ]] && TOTAL=$((TOTAL + 1))
  
  # Verify Single Feed Implementation (V2)
  if [[ -n "$SINGLE_IMPL" ]] && [[ "$SINGLE_IMPL" != "null" ]] && [[ "$SINGLE_IMPL" != "" ]]; then
    COUNT=$((COUNT + 1))
    echo "$COUNT/$TOTAL Verifying Single Feed Implementation (V2)..."
    echo "   Address: $SINGLE_IMPL"
    "$FORGE" verify-contract \
      "$SINGLE_IMPL" \
      src/price/HarborSingleFeedAndRateAggregator_v2.sol:HarborSingleFeedAndRateAggregator_v2 \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
      --constructor-args "$IMPL_CONSTRUCTOR_ARGS" \
      --compiler-version 0.8.30 \
      --chain arbitrum && echo "  ✓ Single Feed Implementation (V2) verified" || echo "  ✗ Single Feed Implementation (V2) verification failed"
    echo ""
  fi
  
  # Verify Double Feed Implementation (V2)
  if [[ -n "$DOUBLE_IMPL" ]] && [[ "$DOUBLE_IMPL" != "null" ]] && [[ "$DOUBLE_IMPL" != "" ]]; then
    COUNT=$((COUNT + 1))
    echo "$COUNT/$TOTAL Verifying Double Feed Implementation (V2)..."
    echo "   Address: $DOUBLE_IMPL"
    "$FORGE" verify-contract \
      "$DOUBLE_IMPL" \
      src/price/HarborDoubleFeedAndRateAggregator_v2.sol:HarborDoubleFeedAndRateAggregator_v2 \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
      --constructor-args "$IMPL_CONSTRUCTOR_ARGS" \
      --compiler-version 0.8.30 \
      --chain arbitrum && echo "  ✓ Double Feed Implementation (V2) verified" || echo "  ✗ Double Feed Implementation (V2) verification failed"
    echo ""
  fi
  
  # Verify Custom Feed Implementation (V2)
  if [[ -n "$CUSTOM_IMPL" ]] && [[ "$CUSTOM_IMPL" != "null" ]] && [[ "$CUSTOM_IMPL" != "" ]]; then
    COUNT=$((COUNT + 1))
    echo "$COUNT/$TOTAL Verifying Custom Feed Implementation (V2)..."
    echo "   Address: $CUSTOM_IMPL"
    "$FORGE" verify-contract \
      "$CUSTOM_IMPL" \
      src/price/HarborCustomFeedAndRateAggregator_v2.sol:HarborCustomFeedAndRateAggregator_v2 \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
      --constructor-args "$IMPL_CONSTRUCTOR_ARGS" \
      --compiler-version 0.8.30 \
      --chain arbitrum && echo "  ✓ Custom Feed Implementation (V2) verified" || echo "  ✗ Custom Feed Implementation (V2) verification failed"
  fi
  
  echo ""
  echo "✅ Implementation verification complete!"
  exit 0
fi

