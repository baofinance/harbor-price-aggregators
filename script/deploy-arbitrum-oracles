  current_val=$(eval echo \$$var_name)
  
    INIT_DATA=$("$CAST" calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256,bool)" \
      "$OWNER" "stETHTo${stock}" 3 "$STETH_USD_FEED" "$feed" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV" false)
  STETH_STOCK_INIT_DATA+=("$INIT_DATA")
  
  if [[ -z "$current_val" ]] || [[ "$current_val" == "null" ]] || [[ "$current_val" == "" ]]; then
    eval "${var_name}=\$(deploy_proxy \"\$DOUBLE_IMPL\" \"\$INIT_DATA\")"
    save_state
  else
    echo "✓ stETH→${stock} already deployed: $current_val"
  fi
done

# stETH→MAG7 (Custom Feed: aggregates AAPL, GOOGL, NVDA, AMZN, MSFT, META, TSLA, divides by 7)
echo ""
echo "--- stETH Custom Feed Oracle (MAG7) ---"

INIT_DATA_STETH_MAG7=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256,bool)" \
  "$OWNER" "stETHToMAG7" 3 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_CUSTOM" "$AGGREGATION_DIVISOR" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV" false)

if [[ -z "$STETH_MAG7" ]] || [[ "$STETH_MAG7" == "null" ]] || [[ "$STETH_MAG7" == "" ]]; then
  STETH_MAG7=$(deploy_proxy "$CUSTOM_IMPL" "$INIT_DATA_STETH_MAG7")
  save_state
else
  echo "✓ stETH→MAG7 already deployed: $STETH_MAG7"
fi

