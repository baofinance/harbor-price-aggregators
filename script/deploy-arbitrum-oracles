#!/usr/bin/env bash
set -euo pipefail

# Harbor Arbitrum Oracle Deployment Script v2
# Deploys PriceOracle library, implementations, and oracle proxies
# Includes state tracking, retry logic, and initialization checks
#
# Configuration:
#   - Set RPC_URL and ETHERSCAN_API_KEY as environment variables, or
#   - Create a .env file in the project root (see .env.example)
#   - Environment variables take precedence over .env file

# Use full path to forge/cast
FORGE=${FORGE:-$HOME/.foundry/bin/forge}
CAST=${CAST:-$HOME/.foundry/bin/cast}

# State file for tracking deployments
STATE_FILE="${STATE_FILE:-deployment-state-arbitrum.json}"
MODE="${MODE:-deploy}"  # deploy, check, retry, init, verify

# Load environment variables from .env.local or .env file if they exist (optional)
# Priority: .env.local > .env > environment variables
# You can create a .env.local or .env file in the project root with:
#   RPC_URL=your_rpc_url
#   ETHERSCAN_API_KEY=your_api_key
#   PRIVATE_KEY=your_private_key
#   OWNER=your_owner_address
if [[ -f .env.local ]]; then
  set -a
  source .env.local
  set +a
elif [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

# Configuration: REQUIRED environment variables
# These MUST be set via environment variables or .env file:
#   export RPC_URL="your_rpc_url"
#   export ETHERSCAN_API_KEY="your_api_key"
# Or create a .env file in the project root
if [[ -z "${RPC_URL:-}" ]]; then
  echo "❌ ERROR: RPC_URL is not set"
  echo "   Set it via: export RPC_URL='your_rpc_url'"
  echo "   Or add it to a .env.local or .env file in the project root"
  exit 1
fi
if [[ -z "${ETHERSCAN_API_KEY:-}" ]]; then
  echo "❌ ERROR: ETHERSCAN_API_KEY is not set"
  echo "   Set it via: export ETHERSCAN_API_KEY='your_api_key'"
  echo "   Or add it to a .env.local or .env file in the project root"
  exit 1
fi

# Use PRIVATE_KEY_LOCAL if set, otherwise fall back to PRIVATE_KEY or default
PRIVATE_KEY=${PRIVATE_KEY_LOCAL:-${PRIVATE_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80}}
OWNER=${OWNER:-0x2f1567c4a651ed93db0fc6d9df1ea9196054f63e}

# Initialize variables to avoid unbound variable errors
PRICE_ORACLE_LIB="${PRICE_ORACLE_LIB:-0x07f347B979fCE7cD7Bb761fEda6bd7Dfea19a6A5}"
SINGLE_IMPL="${SINGLE_IMPL:-}"
DOUBLE_IMPL="${DOUBLE_IMPL:-}"
CUSTOM_IMPL="${CUSTOM_IMPL:-}"
SUSDE_USD="${SUSDE_USD:-}"
SUSDE_AAPL="${SUSDE_AAPL:-}"
SUSDE_AMZN="${SUSDE_AMZN:-}"
SUSDE_GOOGL="${SUSDE_GOOGL:-}"
SUSDE_META="${SUSDE_META:-}"
SUSDE_MSFT="${SUSDE_MSFT:-}"
SUSDE_NVDA="${SUSDE_NVDA:-}"
SUSDE_SPY="${SUSDE_SPY:-}"
SUSDE_TSLA="${SUSDE_TSLA:-}"
WSTETH_USD="${WSTETH_USD:-}"
WSTETH_AAPL="${WSTETH_AAPL:-}"
WSTETH_AMZN="${WSTETH_AMZN:-}"
WSTETH_GOOGL="${WSTETH_GOOGL:-}"
WSTETH_META="${WSTETH_META:-}"
WSTETH_MSFT="${WSTETH_MSFT:-}"
WSTETH_NVDA="${WSTETH_NVDA:-}"
WSTETH_SPY="${WSTETH_SPY:-}"
WSTETH_TSLA="${WSTETH_TSLA:-}"
WSTETH_MAG7="${WSTETH_MAG7:-}"
SUSDE_MAG7="${SUSDE_MAG7:-}"

# Helper function to save state
save_state() {
  local state_json=$(cat <<EOF
{
  "library": "${PRICE_ORACLE_LIB:-}",
  "implementations": {
    "SINGLE": "${SINGLE_IMPL:-}",
    "DOUBLE": "${DOUBLE_IMPL:-}",
    "CUSTOM": "${CUSTOM_IMPL:-}"
  },
  "proxies": {
    "SUSDE_USD": "${SUSDE_USD:-}",
    "SUSDE_AAPL": "${SUSDE_AAPL:-}",
    "SUSDE_AMZN": "${SUSDE_AMZN:-}",
    "SUSDE_GOOGL": "${SUSDE_GOOGL:-}",
    "SUSDE_META": "${SUSDE_META:-}",
    "SUSDE_MSFT": "${SUSDE_MSFT:-}",
    "SUSDE_NVDA": "${SUSDE_NVDA:-}",
    "SUSDE_SPY": "${SUSDE_SPY:-}",
    "SUSDE_TSLA": "${SUSDE_TSLA:-}",
    "WSTETH_USD": "${WSTETH_USD:-}",
    "WSTETH_AAPL": "${WSTETH_AAPL:-}",
    "WSTETH_AMZN": "${WSTETH_AMZN:-}",
    "WSTETH_GOOGL": "${WSTETH_GOOGL:-}",
    "WSTETH_META": "${WSTETH_META:-}",
    "WSTETH_MSFT": "${WSTETH_MSFT:-}",
    "WSTETH_NVDA": "${WSTETH_NVDA:-}",
    "WSTETH_SPY": "${WSTETH_SPY:-}",
    "WSTETH_TSLA": "${WSTETH_TSLA:-}",
    "WSTETH_MAG7": "${WSTETH_MAG7:-}",
    "SUSDE_MAG7": "${SUSDE_MAG7:-}"
  },
  "deployment_time": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
)
  echo "$state_json" > "$STATE_FILE"
  echo "✓ State saved to $STATE_FILE"
}

# Helper function to load state
load_state() {
  if [[ -f "$STATE_FILE" ]]; then
    echo "📂 Loading state from $STATE_FILE"
    local val=$(jq -r '.library // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && PRICE_ORACLE_LIB="$val"
    
    val=$(jq -r '.implementations.SINGLE // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && SINGLE_IMPL="$val"
    
    val=$(jq -r '.implementations.DOUBLE // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && DOUBLE_IMPL="$val"
    
    val=$(jq -r '.implementations.CUSTOM // empty' "$STATE_FILE" 2>/dev/null || echo "")
    [[ -n "$val" ]] && [[ "$val" != "null" ]] && CUSTOM_IMPL="$val"
    
    # Load all proxy addresses
    for proxy_name in SUSDE_USD SUSDE_AAPL SUSDE_AMZN SUSDE_GOOGL SUSDE_META SUSDE_MSFT SUSDE_NVDA SUSDE_SPY SUSDE_TSLA SUSDE_MAG7 \
                      WSTETH_USD WSTETH_AAPL WSTETH_AMZN WSTETH_GOOGL WSTETH_META WSTETH_MSFT WSTETH_NVDA WSTETH_SPY WSTETH_TSLA WSTETH_MAG7; do
      val=$(jq -r ".proxies.$proxy_name // empty" "$STATE_FILE" 2>/dev/null || echo "")
      if [[ -n "$val" ]] && [[ "$val" != "null" ]]; then
        eval "${proxy_name}=\"$val\""
      fi
    done
    
    return 0
  else
    return 1
  fi
}

# Helper function to check if contract is initialized
check_initialized() {
  local proxy=$1
  local name=$2
  
  if [[ -z "$proxy" ]] || [[ "$proxy" == "null" ]] || [[ "$proxy" == "" ]]; then
    echo "❌ $name: Not deployed"
    return 1
  fi
  
  local code=$("$CAST" code "$proxy" --rpc-url "$RPC_URL" 2>/dev/null | head -1)
  if [[ "$code" == "0x" ]]; then
    echo "❌ $name ($proxy): No code at address"
    return 1
  fi
  
  local oracle_name=$("$CAST" call "$proxy" "oracleName()(string)" --rpc-url "$RPC_URL" 2>/dev/null || echo "")
  if [[ -n "$oracle_name" ]] && [[ "$oracle_name" != "" ]]; then
    echo "✅ $name ($proxy): Initialized (name: $oracle_name)"
    return 0
  else
    echo "⚠️  $name ($proxy): Deployed but NOT initialized"
    return 1
  fi
}

# Function to check all deployments
check_all_deployments() {
  echo "=== CHECKING DEPLOYMENT STATUS ==="
  echo ""
  
  if ! load_state; then
    echo "❌ No state file found: $STATE_FILE"
    echo "   Run with MODE=deploy to start deployment"
    return 1
  fi
  
  echo "Library: ${PRICE_ORACLE_LIB:-not set}"
  echo "Implementations: Single=${SINGLE_IMPL:-not set}, Double=${DOUBLE_IMPL:-not set}, Custom=${CUSTOM_IMPL:-not set}"
  echo ""
  
  local all_ok=true
  
  check_initialized "$SUSDE_USD" "sUSDE→USD" || all_ok=false
  check_initialized "$SUSDE_AAPL" "sUSDE→AAPL" || all_ok=false
  check_initialized "$SUSDE_AMZN" "sUSDE→AMZN" || all_ok=false
  check_initialized "$SUSDE_GOOGL" "sUSDE→GOOGL" || all_ok=false
  check_initialized "$SUSDE_META" "sUSDE→META" || all_ok=false
  check_initialized "$SUSDE_MSFT" "sUSDE→MSFT" || all_ok=false
  check_initialized "$SUSDE_NVDA" "sUSDE→NVDA" || all_ok=false
  check_initialized "$SUSDE_SPY" "sUSDE→SPY" || all_ok=false
  check_initialized "$SUSDE_TSLA" "sUSDE→TSLA" || all_ok=false
  check_initialized "$WSTETH_USD" "wstETH→USD" || all_ok=false
  check_initialized "$WSTETH_AAPL" "wstETH→AAPL" || all_ok=false
  check_initialized "$WSTETH_AMZN" "wstETH→AMZN" || all_ok=false
  check_initialized "$WSTETH_GOOGL" "wstETH→GOOGL" || all_ok=false
  check_initialized "$WSTETH_META" "wstETH→META" || all_ok=false
  check_initialized "$WSTETH_MSFT" "wstETH→MSFT" || all_ok=false
  check_initialized "$WSTETH_NVDA" "wstETH→NVDA" || all_ok=false
  check_initialized "$WSTETH_SPY" "wstETH→SPY" || all_ok=false
  check_initialized "$WSTETH_TSLA" "wstETH→TSLA" || all_ok=false
  check_initialized "$WSTETH_MAG7" "wstETH→MAG7" || all_ok=false
  check_initialized "$SUSDE_MAG7" "sUSDE→MAG7" || all_ok=false
  
  echo ""
  if [[ "$all_ok" == "true" ]]; then
    echo "✅ All contracts are deployed and initialized!"
  else
    echo "⚠️  Some contracts need attention. Run with MODE=retry to initialize missing contracts."
  fi
  
  return 0
}

# Check network
CHAIN_ID=$("$CAST" chain-id --rpc-url "$RPC_URL" 2>/dev/null || echo "unknown")
echo "=== Network Check ==="
echo "RPC URL: $RPC_URL"
echo "Chain ID: $CHAIN_ID"
if [[ "$CHAIN_ID" != "0xa4b1" ]] && [[ "$CHAIN_ID" != "42161" ]]; then
  echo "⚠️  WARNING: Expected Arbitrum chain ID (42161), got: $CHAIN_ID"
  echo "   Press Ctrl+C to cancel, or wait 5 seconds to continue..."
  sleep 5
fi
echo ""

# Arbitrum contract addresses
WSTETH=${WSTETH:-0x5979D7b546E38E414F7E9822514be443A4800529}  # Arbitrum wstETH
FXSAVE=${FXSAVE:-0x0000000000000000000000000000000000000000}  # Not used for stock oracles

# Chainlink feeds on Arbitrum
SUSDE_USDE_FEED=${SUSDE_USDE_FEED:-0x605EA726F0259a30db5b7c9ef39Df9fE78665C44}
USDE_USD_FEED=${USDE_USD_FEED:-0x88AC7Bca36567525A866138F03a6F6844868E0Bc}
WSTETH_STETH_FEED=${WSTETH_STETH_FEED:-0xB1552C5e96B312d0Bf8b554186F846C40614a540}
STETH_USD_FEED=${STETH_USD_FEED:-0x07C5b924399cc23c24a95c8743DE4006a32b7f2a}

# Stock price feeds on Arbitrum
AAPL_USD_FEED=${AAPL_USD_FEED:-0x8d0CC5f38f9E802475f2CFf4F9fc7000C2E1557c}
AMZN_USD_FEED=${AMZN_USD_FEED:-0xd6a77691f071E98Df7217BED98f38ae6d2313EBA}
GOOGL_USD_FEED=${GOOGL_USD_FEED:-0x1D1a83331e9D255EB1Aaf75026B60dFD00A252ba}
META_USD_FEED=${META_USD_FEED:-0xcd1bd86fDc33080DCF1b5715B6FCe04eC6F85845}
MSFT_USD_FEED=${MSFT_USD_FEED:-0xDde33fb9F21739602806580bdd73BAd831DcA867}
NVDA_USD_FEED=${NVDA_USD_FEED:-0x4881A4418b5F2460B21d6F08CD5aA0678a7f262F}
SPY_USD_FEED=${SPY_USD_FEED:-0x46306F3795342117721D8DEd50fbcF6DF2b3cc10}
TSLA_USD_FEED=${TSLA_USD_FEED:-0x3609baAa0a9b1f0FE4d6CC01884585d0e191C3E3}

# Constraints
MAX_AGE=${MAX_AGE:-604800}
MAX_DEV=${MAX_DEV:-50000000000000000}
MAX_RATE_SOURCE_AGE=${MAX_RATE_SOURCE_AGE:-604800}  # Default: 7 days (604800 seconds)

# Define arrays for verification mode
declare -a SUSDE_STOCKS=("AAPL" "AMZN" "GOOGL" "META" "MSFT" "NVDA" "SPY" "TSLA")
declare -a SUSDE_STOCK_FEEDS=("$AAPL_USD_FEED" "$AMZN_USD_FEED" "$GOOGL_USD_FEED" "$META_USD_FEED" "$MSFT_USD_FEED" "$NVDA_USD_FEED" "$SPY_USD_FEED" "$TSLA_USD_FEED")
declare -a SUSDE_STOCK_VARS=("SUSDE_AAPL" "SUSDE_AMZN" "SUSDE_GOOGL" "SUSDE_META" "SUSDE_MSFT" "SUSDE_NVDA" "SUSDE_SPY" "SUSDE_TSLA")
declare -a WSTETH_STOCKS=("AAPL" "AMZN" "GOOGL" "META" "MSFT" "NVDA" "SPY" "TSLA")
declare -a WSTETH_STOCK_FEEDS=("$AAPL_USD_FEED" "$AMZN_USD_FEED" "$GOOGL_USD_FEED" "$META_USD_FEED" "$MSFT_USD_FEED" "$NVDA_USD_FEED" "$SPY_USD_FEED" "$TSLA_USD_FEED")
declare -a WSTETH_STOCK_VARS=("WSTETH_AAPL" "WSTETH_AMZN" "WSTETH_GOOGL" "WSTETH_META" "WSTETH_MSFT" "WSTETH_NVDA" "WSTETH_SPY" "WSTETH_TSLA")

# Additional variables for custom feeds
USD_FEED_FOR_SUSDE_CUSTOM=${USD_FEED_FOR_SUSDE_CUSTOM:-$USDE_USD_FEED}
AGGREGATION_DIVISOR_SUSDE=${AGGREGATION_DIVISOR_SUSDE:-7}
USD_FEED_FOR_CUSTOM=${USD_FEED_FOR_CUSTOM:-$STETH_USD_FEED}
AGGREGATION_DIVISOR=${AGGREGATION_DIVISOR:-7}

# Handle different modes
if [[ "$MODE" == "check" ]]; then
  check_all_deployments
  exit 0
fi

if [[ "$MODE" == "verify" ]]; then
  # Load state first
  if ! load_state; then
    echo "❌ No state file found: $STATE_FILE"
    echo "   Deploy contracts first with: ./script/deploy-arbitrum-oracles"
    exit 1
  fi
  
  # Check if ETHERSCAN_API_KEY is set
  if [[ -z "$ETHERSCAN_API_KEY" ]]; then
    echo "❌ ETHERSCAN_API_KEY is not set. Cannot verify contracts."
    exit 1
  fi
  
  echo "=== VERIFYING ALL CONTRACTS ON ARBISCAN ==="
  echo ""
  
  # Pre-compute constructor args for implementations
  IMPL_CONSTRUCTOR_ARGS=$("$CAST" abi-encode "constructor(address,address,address,address)" "$WSTETH" "$FXSAVE" "$SUSDE_USDE_FEED" "$WSTETH_STETH_FEED")
  
  # Verify Library
  echo "1/24 Verifying Library..."
  "$FORGE" verify-contract \
    "$PRICE_ORACLE_LIB" \
    src/price/PriceOracle_v1.sol:PriceOracle_v1 \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ Library verified" || echo "  ✗ Library verification failed"
  
  # Verify Implementations
  echo ""
  echo "2/24 Verifying Single Feed Implementation..."
  "$FORGE" verify-contract \
    "$SINGLE_IMPL" \
    src/price/HarborSingleFeedAndRateAggregator_v1.sol:HarborSingleFeedAndRateAggregator_v1 \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
    --constructor-args "$IMPL_CONSTRUCTOR_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ Single Feed Implementation verified" || echo "  ✗ Single Feed Implementation verification failed"
  
  echo ""
  echo "3/24 Verifying Double Feed Implementation..."
  "$FORGE" verify-contract \
    "$DOUBLE_IMPL" \
    src/price/HarborDoubleFeedAndRateAggregator_v1.sol:HarborDoubleFeedAndRateAggregator_v1 \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
    --constructor-args "$IMPL_CONSTRUCTOR_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ Double Feed Implementation verified" || echo "  ✗ Double Feed Implementation verification failed"
  
  echo ""
  echo "4/24 Verifying Custom Feed Implementation..."
  "$FORGE" verify-contract \
    "$CUSTOM_IMPL" \
    src/price/HarborCustomFeedAndRateAggregator_v1.sol:HarborCustomFeedAndRateAggregator_v1 \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --libraries src/price/PriceOracle_v1.sol:PriceOracle_v1:$PRICE_ORACLE_LIB \
    --constructor-args "$IMPL_CONSTRUCTOR_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ Custom Feed Implementation verified" || echo "  ✗ Custom Feed Implementation verification failed"
  
  # Verify Proxies
  echo ""
  echo "=== Verifying Proxy Contracts ==="
  
  # sUSDE→USD
  INIT_DATA_SUSDE_USD_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address,uint256,uint64,uint256)" \
    "$OWNER" "sUSDEToUSD" 2 "$USDE_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV")
  PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$SINGLE_IMPL" "$INIT_DATA_SUSDE_USD_VERIFY")
  echo "5/24 Verifying sUSDE→USD..."
  "$FORGE" verify-contract \
    "$SUSDE_USD" \
    lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --constructor-args "$PROXY_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ sUSDE→USD verified" || echo "  ✗ sUSDE→USD verification failed"
  
  # sUSDE stock oracles
  counter=6
  for i in "${!SUSDE_STOCKS[@]}"; do
    stock="${SUSDE_STOCKS[$i]}"
    var_name="${SUSDE_STOCK_VARS[$i]}"
    proxy_addr=$(eval echo \$$var_name)
    feed="${SUSDE_STOCK_FEEDS[$i]}"
    
    init_data=$("$CAST" calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
      "$OWNER" "sUSDETo${stock}" 2 "$USDE_USD_FEED" "$feed" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
    PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$DOUBLE_IMPL" "$init_data")
    echo "${counter}/24 Verifying sUSDE→${stock}..."
    "$FORGE" verify-contract \
      "$proxy_addr" \
      lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --constructor-args "$PROXY_ARGS" \
      --compiler-version 0.8.30 \
      --chain arbitrum && echo "  ✓ sUSDE→${stock} verified" || echo "  ✗ sUSDE→${stock} verification failed"
    ((counter++))
  done
  
  # sUSDE→MAG7
  INIT_DATA_SUSDE_MAG7_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256)" \
    "$OWNER" "sUSDEToMAG7" 2 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_SUSDE_CUSTOM" "$AGGREGATION_DIVISOR_SUSDE" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
  PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$CUSTOM_IMPL" "$INIT_DATA_SUSDE_MAG7_VERIFY")
  echo "${counter}/24 Verifying sUSDE→MAG7..."
  "$FORGE" verify-contract \
    "$SUSDE_MAG7" \
    lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --constructor-args "$PROXY_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ sUSDE→MAG7 verified" || echo "  ✗ sUSDE→MAG7 verification failed"
  ((counter++))
  
  # wstETH→USD
  INIT_DATA_WSTETH_USD_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address,uint256,uint64,uint256)" \
    "$OWNER" "wstETHToUSD" 3 "$STETH_USD_FEED" 1 "$MAX_AGE" "$MAX_DEV")
  PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$SINGLE_IMPL" "$INIT_DATA_WSTETH_USD_VERIFY")
  echo "${counter}/24 Verifying wstETH→USD..."
  "$FORGE" verify-contract \
    "$WSTETH_USD" \
    lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --constructor-args "$PROXY_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ wstETH→USD verified" || echo "  ✗ wstETH→USD verification failed"
  ((counter++))
  
  # wstETH stock oracles
  for i in "${!WSTETH_STOCKS[@]}"; do
    stock="${WSTETH_STOCKS[$i]}"
    var_name="${WSTETH_STOCK_VARS[$i]}"
    proxy_addr=$(eval echo \$$var_name)
    feed="${WSTETH_STOCK_FEEDS[$i]}"
    
    init_data=$("$CAST" calldata "initialize(address,string,uint8,address,address,uint256,uint64,uint256,uint64,uint256)" \
      "$OWNER" "wstETHTo${stock}" 3 "$STETH_USD_FEED" "$feed" 1 "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
    PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$DOUBLE_IMPL" "$init_data")
    echo "${counter}/24 Verifying wstETH→${stock}..."
    "$FORGE" verify-contract \
      "$proxy_addr" \
      lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
      --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" \
      --constructor-args "$PROXY_ARGS" \
      --compiler-version 0.8.30 \
      --chain arbitrum && echo "  ✓ wstETH→${stock} verified" || echo "  ✗ wstETH→${stock} verification failed"
    ((counter++))
  done
  
  # wstETH→MAG7
  INIT_DATA_WSTETH_MAG7_VERIFY=$("$CAST" calldata "initialize(address,string,uint8,address[],address,uint256,uint64,uint256,uint64,uint256)" \
    "$OWNER" "wstETHToMAG7" 3 "[$AAPL_USD_FEED,$GOOGL_USD_FEED,$NVDA_USD_FEED,$AMZN_USD_FEED,$MSFT_USD_FEED,$META_USD_FEED,$TSLA_USD_FEED]" "$USD_FEED_FOR_CUSTOM" "$AGGREGATION_DIVISOR" "$MAX_AGE" "$MAX_DEV" "$MAX_AGE" "$MAX_DEV")
  PROXY_ARGS=$("$CAST" abi-encode "constructor(address,bytes)" "$CUSTOM_IMPL" "$INIT_DATA_WSTETH_MAG7_VERIFY")
  echo "${counter}/24 Verifying wstETH→MAG7..."
  "$FORGE" verify-contract \
    "$WSTETH_MAG7" \
    lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy \
    --verifier etherscan \
    --etherscan-api-key "$ETHERSCAN_API_KEY" \
    --constructor-args "$PROXY_ARGS" \
    --compiler-version 0.8.30 \
    --chain arbitrum && echo "  ✓ wstETH→MAG7 verified" || echo "  ✗ wstETH→MAG7 verification failed"
  
  echo ""
  echo "✅ Verification complete!"
  exit 0
fi

