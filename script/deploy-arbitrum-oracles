if [[ -n "${MANUAL_STETH_MAG7:-}" ]]; then STETH_MAG7="$MANUAL_STETH_MAG7"; fi

# Helper function to get contract address from transaction hash
get_contract_from_tx() {
  local tx_hash=$1
  if [[ ${#tx_hash} -eq 66 ]] && [[ "$tx_hash" =~ ^0x[0-9a-fA-F]{64}$ ]]; then
    # This looks like a transaction hash, try to get contract address
    local contract=$("$CAST" receipt "$tx_hash" contractAddress --rpc-url "$RPC_URL" 2>/dev/null || echo "")
    if [[ -n "$contract" ]] && [[ "$contract" != "null" ]] && [[ "$contract" != "" ]]; then
      echo "$contract"
      return 0
    fi
  fi
  # If it's already a contract address (42 chars), return as-is
  if [[ ${#tx_hash} -eq 42 ]] && [[ "$tx_hash" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
    echo "$tx_hash"
    return 0
  fi
  echo ""
  return 1
}

# Helper to update state file with transaction hashes (will convert to addresses)
update_state_from_txs() {
  local single_impl_tx=${1:-}
  local double_impl_tx=${2:-}
  local custom_impl_tx=${3:-}
  shift 3
  local proxy_txs=("$@")
  
  if [[ -n "$single_impl_tx" ]]; then
    local impl_addr=$(get_contract_from_tx "$single_impl_tx")
    if [[ -n "$impl_addr" ]]; then
      SINGLE_IMPL="$impl_addr"
      echo "✓ Extracted Single Feed implementation address: $SINGLE_IMPL"
    else
      echo "⚠️  Could not extract address from Single Feed implementation tx: $single_impl_tx"
    fi
  fi
  
  if [[ -n "$double_impl_tx" ]]; then
    local impl_addr=$(get_contract_from_tx "$double_impl_tx")
    if [[ -n "$impl_addr" ]]; then
      DOUBLE_IMPL="$impl_addr"
      echo "✓ Extracted Double Feed implementation address: $DOUBLE_IMPL"
    else
      echo "⚠️  Could not extract address from Double Feed implementation tx: $double_impl_tx"
    fi
  fi
  
  if [[ -n "$custom_impl_tx" ]]; then
    local impl_addr=$(get_contract_from_tx "$custom_impl_tx")
    if [[ -n "$impl_addr" ]]; then
      CUSTOM_IMPL="$impl_addr"
      echo "✓ Extracted Custom Feed implementation address: $CUSTOM_IMPL"
    else
      echo "⚠️  Could not extract address from Custom Feed implementation tx: $custom_impl_tx"
    fi
  fi
  
  # Map proxy transaction hashes to their names (20 proxies total)
  local proxy_names=("USDE_USD" "USDE_AAPL" "USDE_AMZN" "USDE_GOOGL" "USDE_META" "USDE_MSFT" "USDE_NVDA" "USDE_SPY" "USDE_TSLA" "USDE_MAG7" \
                     "STETH_USD" "STETH_AAPL" "STETH_AMZN" "STETH_GOOGL" "STETH_META" "STETH_MSFT" "STETH_NVDA" "STETH_SPY" "STETH_TSLA" "STETH_MAG7")
  
  for i in "${!proxy_txs[@]}"; do
    if [[ $i -lt ${#proxy_names[@]} ]] && [[ -n "${proxy_txs[$i]}" ]]; then
      local proxy_addr=$(get_contract_from_tx "${proxy_txs[$i]}")
      if [[ -n "$proxy_addr" ]]; then
        case "${proxy_names[$i]}" in
          "USDE_USD") USDE_USD="$proxy_addr" ;;
          "USDE_AAPL") USDE_AAPL="$proxy_addr" ;;
          "USDE_AMZN") USDE_AMZN="$proxy_addr" ;;
          "USDE_GOOGL") USDE_GOOGL="$proxy_addr" ;;
          "USDE_META") USDE_META="$proxy_addr" ;;
          "USDE_MSFT") USDE_MSFT="$proxy_addr" ;;
          "USDE_NVDA") USDE_NVDA="$proxy_addr" ;;
          "USDE_SPY") USDE_SPY="$proxy_addr" ;;
          "USDE_TSLA") USDE_TSLA="$proxy_addr" ;;
          "USDE_MAG7") USDE_MAG7="$proxy_addr" ;;
          "STETH_USD") STETH_USD="$proxy_addr" ;;
          "STETH_AAPL") STETH_AAPL="$proxy_addr" ;;
          "STETH_AMZN") STETH_AMZN="$proxy_addr" ;;
          "STETH_GOOGL") STETH_GOOGL="$proxy_addr" ;;
          "STETH_META") STETH_META="$proxy_addr" ;;
          "STETH_MSFT") STETH_MSFT="$proxy_addr" ;;
          "STETH_NVDA") STETH_NVDA="$proxy_addr" ;;
          "STETH_SPY") STETH_SPY="$proxy_addr" ;;
          "STETH_TSLA") STETH_TSLA="$proxy_addr" ;;
          "STETH_MAG7") STETH_MAG7="$proxy_addr" ;;
        esac
        echo "✓ Extracted ${proxy_names[$i]} address: $proxy_addr"
      else
        echo "⚠️  Could not extract address from ${proxy_names[$i]} tx: ${proxy_txs[$i]}"
      fi
    fi
  done
  
  save_state
}

